<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MikoMiko</RootNamespace>
    <AssemblyName>MikoMiko</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.1.59</Version>
    <Product>MikoMiko</Product>
    <AssemblyTitle>MikoMiko</AssemblyTitle>
    <Company>Huiusto</Company>
    <Authors>灰岁Huiusto</Authors>
    <Copyright>Copyright © 2026 Huiusto. MIT License.</Copyright>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\wordmark.png" />
    <Resource Include="Assets\logo_transparent.png" />
    <Resource Include="Assets\Nav\*.png" />
    <Resource Include="Assets\Games\*.png" />
    <Resource Include="Assets\Launch\*.jpg" />
    <Resource Include="Assets\Launch\*.html" />
    <Resource Include="Assets\Launch\icons\*.png" />
    <Resource Include="Assets\Profile\*.png" />
    <Resource Include="Assets\Demo\*.jpg" />
    <Resource Include="Assets\Demo\*.png" />
    <Resource Include="Assets\Anime\*.png" />
    <Resource Include="Assets\Anime\*.jpg" />
    <Resource Include="Assets\Anime\hls.min.js" />
    <Resource Include="Assets\Setup\*.png" />
    <Resource Include="Assets\Setup\*.gif" />
    <Resource Include="Assets\Sections\*.jpg" />
    <Resource Include="Assets\Sections\*.jpeg" />
    <Resource Include="Assets\Sections\*.png" />
    <Resource Include="Assets\Verify\*.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Anime\anime-module.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Anime\flutter\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" />
    <None Include="..\..\LICENSE" Link="LICENSE" />
  </ItemGroup>

</Project>









