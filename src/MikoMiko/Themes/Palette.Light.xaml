<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MikoMiko · Light palette -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.NavBg" Color="#FCFDFE" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#F5F7FA" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E7EAF0" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="#F0F2F6" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#171A20" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#606670" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9298A3" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#4EA4DD" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6FB8E7" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E8F4FC" />
    <SolidColorBrush x:Key="Brush.AccentOverlay" Color="#334EA4DD" />

    <SolidColorBrush x:Key="Brush.ControlBg" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#E1E5EC" />
    <SolidColorBrush x:Key="Brush.SearchBg" Color="#F2F4F7" />
    <SolidColorBrush x:Key="Brush.HeaderHover" Color="#F2F4F7" />
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#FF5C5C" />

    <SolidColorBrush x:Key="Brush.PlayerBg" Color="#0E1013" />
    <SolidColorBrush x:Key="Brush.PlayerOverlay" Color="#CC000000" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#D3D8E0" />

    <SolidColorBrush x:Key="Brush.TaxOrange" Color="#FF7A45" />
    <SolidColorBrush x:Key="Brush.TagOrange" Color="#FF7A45" />
    <SolidColorBrush x:Key="Brush.TagOrangeBg" Color="#FFF2EB" />
    <SolidColorBrush x:Key="Brush.TagBlue" Color="#00AEEC" />
    <SolidColorBrush x:Key="Brush.TagBlueBg" Color="#EAF8FE" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F2555A" />
    <SolidColorBrush x:Key="Brush.Success" Color="#39B86A" />

    <SolidColorBrush x:Key="Brush.Shade10" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Shade40" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.Shade60" Color="#99000000" />

    <LinearGradientBrush x:Key="Brush.CoverMask" StartPoint="0.5,0.35" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#A6000000" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
