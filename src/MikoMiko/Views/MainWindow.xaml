<Window x:Class="MikoMiko.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MikoMiko.Localization"
        xmlns:conv="clr-namespace:MikoMiko.Converters"
        mc:Ignorable="d"
        Title="MikoMiko"
        Icon="pack://application:,,,/Assets/icon.png"
        Width="1240" Height="800" MinWidth="1080" MinHeight="680"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseDown="Window_PreviewMouseDown"
        FontFamily="{DynamicResource Font.Ui}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Brush.WindowBg}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 左侧导航 ==================== -->
            <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource Brush.NavBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                    CornerRadius="10,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl ItemsSource="{Binding Navigation}" Margin="0,18,0,0" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Height="76"
                                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="14,0,14,8" />
                        <ItemsControl ItemsSource="{Binding FooterNavigation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButton}" Height="76"
                                            Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 页头 ==================== -->
            <Grid Grid.Row="0" Grid.Column="1" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource CaptionButton}" Width="34" Height="30"
                        Margin="8,0,0,0" Click="Back_Click"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [Common.Back], Source={x:Static loc:Loc.Instance}}">
                    <Path Data="M13 2 L5 10 L13 18" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="20" Stretch="Uniform" />
                </Button>

                <Image Grid.Column="1" Source="pack://application:,,,/Assets/wordmark.png"
                       Height="30" Margin="22,0,12,0" VerticalAlignment="Center" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <ItemsControl Grid.Column="2" ItemsSource="{Binding HomeTabs}" VerticalAlignment="Center"
                              Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TabButton}"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                            <Setter Property="FontSize" Value="16" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="#4EA4DD" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="4" Width="340" Height="36" CornerRadius="8"
                        Background="{DynamicResource Brush.SearchBg}" VerticalAlignment="Center" Margin="10,0,14,0"
                        Visibility="{Binding ShowGlobalSearch, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                              Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.4"
                              Width="18" Height="18" Stretch="Uniform" Margin="12,0,8,0" VerticalAlignment="Center" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                     KeyDown="SearchInput_KeyDown" />
                            <TextBlock Text="{Binding SearchPlaceholder}"
                                       Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12.5"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Width="26" Height="26"
                                Margin="0,0,6,0" Click="ClearSearch_Click"
                                Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}"
                                ToolTip="{Binding [Common.Close], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M0 0 L9 9 M9 0 L0 9" Stroke="{DynamicResource Brush.TextTertiary}"
                                  StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            ToolTip="最小化">
                        <Path Data="M0 0 H11" Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1.4"
                              Width="11" Height="1" Stretch="Fill" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                            ToolTip="最大化 / 还原">
                        <Path x:Name="MaxIcon" Data="M0.5 0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1.2"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" Margin="0,0,4,0"
                            ToolTip="关闭">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextPrimary}"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== 页面内容 ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False" />

            <!-- ==================== 首页「网页」页签（软件内浏览器） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding WebHubPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsWebHubOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 追剧/影视（左侧导航独立板块） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding AnimePage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsAnimePageOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 合集阅读器（软件内打开，点击作品进入帖子阅读器） ==================== -->
            <ContentControl x:Name="CollectionHost" Grid.Row="1" Grid.Column="1" Content="{Binding CollectionReaderView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsCollectionReaderOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 帖子阅读器（软件内打开，覆盖内容区） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ReaderView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsReaderOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 用户主页（软件内覆盖，不新开窗口） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ProfileView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 游戏预约页（官方启动器同款版式，覆盖内容区） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ReservationView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False" />

            <!-- ==================== 软件内网页（正文外链，不跳系统浏览器） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding BrowserView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsBrowserOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 追番/影视内置播放器（只播放提取出的视频流） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding AnimePlayerView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsAnimePlayerOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 追番/影视站点网页播放（直连流失败时的兜底） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding AnimeSitePlayerView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsAnimeSitePlayerOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ==================== 上传内容弹层（先选板块，再选发布类型） ==================== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding UploadView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Focusable="False"
                            Visibility="{Binding IsUploadOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Border>
</Window>
