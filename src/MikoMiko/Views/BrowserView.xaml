<UserControl x:Class="MikoMiko.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                        Click="Back_Click" ToolTip="后退">
                    <Path Data="M10 2 L4 7 L10 12" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.5" Width="9" Height="12" Stretch="Uniform" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                        Margin="2,0,0,0" Click="Reload_Click" ToolTip="刷新">
                    <Path Data="M7 1 A6 6 0 1 0 13 6 M13 6 V2.2 M13 6 H9.2" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <Border x:Name="AddressBox" Grid.Column="2" Height="32" CornerRadius="7" Background="{DynamicResource Brush.SearchBg}"
                        Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AddressText" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                </Border>

                <Button Grid.Column="3" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                        Click="Close_Click" ToolTip="{Binding [Common.Close], Source={x:Static loc:Loc.Instance}}">
                    <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextPrimary}"
                          StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#FFFFFFFF">
            <wv2:WebView2 x:Name="Web" Loaded="Web_Loaded" />
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在软件内加载网页…" Foreground="#66707A" FontSize="12.5" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
