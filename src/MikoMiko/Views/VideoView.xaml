<UserControl x:Class="MikoMiko.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </UserControl.Resources>

    <!-- 整幅播放器，像抖音一样上下滑动直接切下一个视频 -->
    <Grid Background="{DynamicResource Brush.PlayerBg}" MouseWheel="PlayerCard_MouseWheel">
        <Border x:Name="PlayerCard" CornerRadius="0" ClipToBounds="True"
                Background="{DynamicResource Brush.PlayerBg}" MouseLeftButtonUp="PlayerCard_Click">
            <Grid>
                <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="True" Stretch="Uniform" Volume="0.6" />

                <!-- 封面层（未播放时显示） -->
                <Grid x:Name="CoverHost" Background="{DynamicResource Brush.PlayerBg}">
                    <Image Source="pack://application:,,,/Assets/Demo/cover01.jpg" Stretch="UniformToFill" />
                    <Image controls:AsyncImage.Url="{Binding Selected.Cover}" Stretch="UniformToFill" />

                    <Border Background="{DynamicResource Brush.CoverMask}" />
                    <Border Background="#40000000" />

                    <!-- 中央播放按钮 -->
                    <Button x:Name="BigPlayButton" Width="76" Height="76" Cursor="Hand"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding TogglePlayCommand}" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Bd" CornerRadius="38" Background="#33FFFFFF"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Path Data="M0 0 L22 12.7 L0 25.4 Z" Fill="White" Width="22" Height="25"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 缓冲 / 无源提示 -->
                    <Border Background="#66000000" CornerRadius="12" Padding="14,6" MaxWidth="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0"
                            Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="{Binding StatusText}" Foreground="#E6FFFFFF" FontSize="12"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </Border>

                    <Border Background="#66000000" CornerRadius="10" Padding="12,5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                            Visibility="{Binding Toast, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="{Binding Toast}" Foreground="#E6FFFFFF" FontSize="11.5" />
                    </Border>
                </Grid>

                <!-- 播放时常驻的信息层：左下 UP 信息 + 标题 -->
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,70" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Padding="0" Command="{Binding OpenAuthorCommand}" Cursor="Hand">
                            <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                                <Image controls:AsyncImage.Url="{Binding Selected.AuthorAvatar}" Stretch="UniformToFill" />
                            </Border>
                        </Button>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding Selected.BadgeBackground}" CornerRadius="4"
                                        Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.BadgeText}" Foreground="{Binding Selected.BadgeForeground}"
                                               FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{Binding Selected.MikoBadgeBackground}" CornerRadius="4"
                                        Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Visibility="{Binding Selected.ShowMikoBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Selected.MikoBadgeText}" Foreground="{Binding Selected.MikoBadgeForeground}"
                                               FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#FFF1F5" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Selected.ShowCertBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="V" Foreground="#F0A9BD" FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                                <Button Style="{StaticResource LinkButton}" Padding="0" Command="{Binding OpenAuthorCommand}" Cursor="Hand">
                                    <TextBlock Text="{Binding Selected.Author}" Foreground="White" FontSize="14"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding FollowAuthorCommand}" Cursor="Hand" Margin="10,0,0,0"
                                        Background="{DynamicResource Brush.Accent}" BorderThickness="0"
                                        Padding="9,3" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding FollowText}" Foreground="White" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.AudienceText}" Foreground="#B3FFFFFF" FontSize="11.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Selected.Title}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               MaxWidth="620" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46"
                               Margin="0,14,0,0" />
                </StackPanel>

                <!-- 播放时常驻的操作列（米游社原生：点赞 / 收藏 / 分享） -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,72">
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Command="{Binding LikeCommand}" Style="{StaticResource CircleActionButton}" Width="36" Height="36">
                            <Path Data="M8 15 C8 15 1 10.5 1 5.6 C1 2.8 3.9 1.2 5.9 2.6 L8 4.6 L10.1 2.6 C12.1 1.2 15 2.8 15 5.6 C15 10.5 8 15 8 15 Z"
                                  Stroke="#E6FFFFFF" StrokeThickness="1" Width="16" Height="16" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#E6FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                <Setter Property="Fill" Value="#FF5C8A" />
                                                <Setter Property="Stroke" Value="#FF5C8A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <TextBlock Text="{Binding VideoLikeText}" Foreground="#E6FFFFFF" FontSize="10.5"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Command="{Binding FavoriteCommand}" Style="{StaticResource CircleActionButton}" Width="36" Height="36">
                            <Path Data="M0 0 L6 3.8 L12 0 V13.4 L6 9.6 L0 13.4 Z" Stroke="White" StrokeThickness="1.3"
                                  Width="14" Height="14" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorited}" Value="True">
                                                <Setter Property="Fill" Value="#FFD166" />
                                                <Setter Property="Stroke" Value="#FFD166" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <TextBlock Text="{Binding FavoriteText}"
                                   Foreground="#E6FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Command="{Binding ToggleCommentsCommand}" Style="{StaticResource CircleActionButton}" Width="36" Height="36">
                            <Path Data="M1 2 H14 V10 H7 L3 13 V10 H1 Z"
                                  Stroke="White" StrokeThickness="1.2" Width="15" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="{Binding CommentCountText}" Foreground="#E6FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Button Command="{Binding OpenInBrowserCommand}" Style="{StaticResource CircleActionButton}" Width="36" Height="36">
                            <Path Data="M1 10 L6 5 M6 5 H2 M6 5 V9 M8 8 V12 H1 V2 H5 M12 8 V12"
                                  Stroke="White" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="发布页"
                                   Foreground="#E6FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 0.1.4：不再显示「第 1/12 个」序号 -->

                <!-- 弹幕层：受「弹幕」按钮控制显隐 -->
                <Canvas x:Name="DanmakuHost" Height="280" VerticalAlignment="Top" Margin="0,54,330,0"
                        IsHitTestVisible="False" ClipToBounds="True"
                        Visibility="{Binding ShowDanmaku, Converter={StaticResource BoolToVis}}" />

                <!-- 右上角不再放画质入口；清晰度已移到下方倍速旁。 -->

                <!-- 返回封面（播放时显示） -->
                <Button x:Name="ReturnCoverButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16" Style="{StaticResource PlayerBarButton}" Padding="10,5"
                        Visibility="Collapsed"
                        Click="ReturnCover_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8 0 L1 6.5 L8 13" Stroke="White" StrokeThickness="1.3" Width="8" Height="13"
                              Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Video.Back], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="11.5" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 三色进度条：白色=未加载，灰色=已缓冲，米蓝=已播放；无常驻滑块、悬停不改变粗细 -->
                <Grid x:Name="ProgressTrack" Height="16" VerticalAlignment="Bottom" Margin="16,0,16,54"
                      Cursor="Arrow" Background="Transparent">
                    <Border Height="3" VerticalAlignment="Center" Background="#FFFFFF" CornerRadius="1.5" />
                    <Border x:Name="BufferBar" Height="3" Width="0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Background="#9A9A9A" CornerRadius="1.5" />
                    <Border x:Name="PlayedBar" Height="3" Width="0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Background="#4EA4DD" CornerRadius="1.5" />
                    <Slider x:Name="ProgressSlider" Height="16" Minimum="0" Maximum="1" Background="Transparent"
                            Cursor="Hand" IsMoveToPointEnabled="True" Focusable="False"
                            PreviewMouseLeftButtonDown="Progress_DragStart"
                            PreviewMouseLeftButtonUp="Progress_DragEnd"
                            LostMouseCapture="Progress_LostMouseCapture"
                            ValueChanged="Progress_ValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="{x:Type Slider}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent"
                                                          BorderThickness="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent"
                                                          BorderThickness="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="12" Height="16" Cursor="Hand">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Grid Background="Transparent">
                                                            <Ellipse Width="10" Height="10" Fill="#FFFFFF"
                                                                     Stroke="#4EA4DD" StrokeThickness="1" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                </Grid>

                <!-- 底部控制栏 -->
                <Border VerticalAlignment="Bottom" Height="54" Background="#D9000000">
                    <Grid Margin="12,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource PlayerBarButton}"
                                Click="PlayPause_Click" Width="30" Padding="4,2">
                            <Path x:Name="PlayPauseIcon" Data="M0 0 L11 7 L0 14 Z" Fill="#E8FFFFFF"
                                  Width="12" Height="14" Stretch="Uniform" />
                        </Button>

                        <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00" Foreground="#D9FFFFFF"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="4,0,12,0" />

                        <Border Grid.Column="2" Width="300" Height="30" CornerRadius="15" Background="#26FFFFFF"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBox x:Name="DanmakuInput" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"
                                         FontSize="12" Padding="12,0" />
                                <TextBlock Text="{Binding DanmakuPlaceholder}"
                                           Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center"
                                           Margin="12,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DanmakuInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Button Grid.Column="3" Content="{Binding [Video.Send], Source={x:Static loc:Loc.Instance}}"
                                HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource PlayerBarButton}" Padding="10,4"
                                Background="{DynamicResource Brush.Accent}" Foreground="White"
                                Click="SendDanmaku_Click" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="QualityButton" Foreground="#E8FFFFFF" Style="{StaticResource PlayerBarButton}"
                                    Command="{Binding ToggleQualityCommand}" ToolTip="清晰度">
                                <TextBlock Text="{Binding QualityText}" Foreground="#E8FFFFFF" FontSize="12" />
                            </Button>
                            <Button x:Name="SpeedButton" Foreground="#E8FFFFFF" Style="{StaticResource PlayerBarButton}"
                                    Command="{Binding ToggleSpeedCommand}">
                                <TextBlock Text="{Binding SpeedText}" Foreground="#E8FFFFFF" FontSize="12" />
                            </Button>
                            <Button Foreground="#E8FFFFFF" Style="{StaticResource PlayerBarButton}"
                                    Command="{Binding ToggleDanmakuCommand}">
                                <TextBlock Text="{Binding [Video.Danmaku], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#88FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDanmaku}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button x:Name="MuteButton" Style="{StaticResource PlayerBarButton}" Click="Mute_Click"
                                    Width="26" Padding="4,2">
                                <Path x:Name="MuteIcon" Data="M0 4 H4 L8 0.5 V13.5 L4 10 H0 Z"
                                      Stroke="#E8FFFFFF" StrokeThickness="1.2" Width="12" Height="13" Stretch="Uniform" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="66" Minimum="0" Maximum="100" Value="60"
                                    Style="{StaticResource ThinSlider}" VerticalAlignment="Center"
                                    ValueChanged="Volume_ValueChanged" Margin="4,0,6,0" />
                            <Button Style="{StaticResource PlayerBarButton}" Click="FullScreen_Click" Width="26" Padding="4,2">
                                <Path Data="M0 5 V0 H5 M8 0 H13 V5 M13 9 V14 H8 M5 14 H0 V9"
                                      Stroke="#E8FFFFFF" StrokeThickness="1.2" Width="13" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 清晰度与下载抽屉（底部倍速旁展开） -->
                <Border Width="176" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,54,58" Background="#F2181820" CornerRadius="10" Padding="6"
                        Visibility="{Binding IsQualityOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="清晰度与下载" Foreground="#80FFFFFF" FontSize="10.5" Margin="8,4,0,6" />
                        <ItemsControl ItemsSource="{Binding QualityOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.PickQualityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0">
                                                    <TextBlock Text="{Binding}" Foreground="#FFFFFFFF" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#334EA4DD" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#33FFFFFF" Margin="8,6,8,5" />
                        <Button Height="32" Padding="10,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch" Command="{Binding DownloadVideoCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0 9 V12 H13 V9 M6.5 0 V8 M3 5 L6.5 8.5 L10 5"
                                                  Stroke="#FFFFFFFF" StrokeThickness="1.2" Width="13" Height="12"
                                                  Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="下载视频" Foreground="White" FontSize="12" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#334EA4DD" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding DownloadText}" Foreground="#B3FFFFFF" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="10,6,10,4" MaxWidth="150"
                                   Visibility="{Binding DownloadText, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Border>
                <Border Width="140" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,90,58" Background="#F2181820" CornerRadius="10" Padding="6"
                        Visibility="{Binding IsSpeedOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="倍速" Foreground="#80FFFFFF" FontSize="10.5" Margin="8,4,0,6" />
                        <ItemsControl ItemsSource="{Binding SpeedOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.PickSpeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0">
                                                    <TextBlock Text="{Binding}" Foreground="#FFFFFFFF" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#334EA4DD" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Width="390" HorizontalAlignment="Right" Margin="0,0,0,54" Background="#F2181820"
                        Visibility="{Binding IsCommentsOpen, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="16,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="评论" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Height="22" Padding="9,0" Margin="12,0,0,0" BorderThickness="0"
                                        Foreground="White" FontSize="10.5" Cursor="Hand"
                                        Command="{Binding SortCommentsDefaultCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background" Value="#22FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentLatest}" Value="False">
                                                    <Setter Property="Background" Value="#4EA4DD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="White" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="默认" Foreground="White" />
                                </Button>
                                <Button Height="22" Padding="9,0" Margin="5,0,0,0" BorderThickness="0"
                                        Foreground="White" FontSize="10.5" Cursor="Hand"
                                        Command="{Binding SortCommentsLatestCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background" Value="#22FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentLatest}" Value="True">
                                                    <Setter Property="Background" Value="#4EA4DD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="White" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="最新" Foreground="White" />
                                </Button>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ToggleCommentsCommand}">
                                <Path Data="M1 1 L11 11 M11 1 L1 11" Stroke="#CCFFFFFF" StrokeThickness="1.4"
                                      Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Cursor="Hand" Width="28" Height="28" Padding="0" BorderThickness="0"
                                                        Background="Transparent"
                                                        Command="{Binding DataContext.OpenCommentUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="查看用户主页">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True"
                                                                    Background="#33FFFFFF">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                                                </Button>
                                                <StackPanel Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Author}" Foreground="#4EA4DD" FontSize="11.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Background="#334EA4DD" CornerRadius="3" Padding="4,0"
                                                                Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Level, StringFormat=Lv.{0}}" FontSize="9.5"
                                                                       Foreground="#8FD0FF" />
                                                        </Border>
                                                        <TextBlock Text="{Binding TimeText}" Foreground="#66FFFFFF" FontSize="10"
                                                                   Margin="8,1,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="该评论已折叠，取消「踩」即可恢复" Foreground="#80FFFFFF"
                                                               FontSize="10.5" Margin="0,5,0,0"
                                                               Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}" />
                                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Content}" Foreground="#EEFFFFFF" FontSize="12.5"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <ItemsControl ItemsSource="{Binding Images}" Margin="0,6,0,0"
                                                                  Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,6,6"
                                                                        MaxWidth="120" MaxHeight="90" Background="#22FFFFFF"
                                                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="CommentImage_Click">
                                                                    <Image controls:AsyncImage.Url="{Binding}" Stretch="Uniform" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Button Style="{StaticResource LinkButton}" Height="18" Padding="0"
                                                                Command="{Binding DataContext.LikeCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="♡" FontSize="10.5" Foreground="#80FFFFFF">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="♡" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                                                <Setter Property="Text" Value="♥" />
                                                                                <Setter Property="Foreground" Value="#FF5C8A" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <TextBlock Text="{Binding LikeText}" Foreground="#66FFFFFF" FontSize="10"
                                                                   Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        <Button Style="{StaticResource LinkButton}" Height="18" Padding="0"
                                                                Margin="12,0,0,0"
                                                                Command="{Binding DataContext.DislikeCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="👎︎" FontSize="10.5" Foreground="#8CFFFFFF">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="👎︎" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                                                <Setter Property="Foreground" Value="#8A8F98" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <Button Content="回复" Style="{StaticResource LinkButton}" Height="18" Padding="0"
                                                                Margin="12,0,0,0" FontSize="10.5" Foreground="#99FFFFFF"
                                                                Command="{Binding DataContext.ReplyToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Children}" Margin="36,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0"
                                                                Padding="8,0,0,0" Margin="0,0,0,7">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Author}" Foreground="#4EA4DD"
                                                                               FontSize="11" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding TimeText}" Foreground="#66FFFFFF"
                                                                               FontSize="9.5" Margin="7,1,0,0" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="10.5" Foreground="#99FFFFFF" Margin="0,3,0,0"
                                                                           Text="{Binding ReplyToName, Mode=OneWay, StringFormat='回复 @{0}：'}"
                                                                           Visibility="{Binding HasReplyTo, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Content}" Foreground="#DDFFFFFF"
                                                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                <ItemsControl ItemsSource="{Binding Images}" Margin="0,4,0,0"
                                                                              Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border CornerRadius="5" ClipToBounds="True" Margin="0,0,5,5"
                                                                                    MaxWidth="92" MaxHeight="70" Background="#22FFFFFF"
                                                                                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="CommentImage_Click">
                                                                                <Image controls:AsyncImage.Url="{Binding}" Stretch="Uniform" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Content="回复" Style="{StaticResource LinkButton}" Height="18"
                                                                        Padding="0" Margin="0,4,0,0" FontSize="10" Foreground="#99FFFFFF"
                                                                        HorizontalAlignment="Left"
                                                                        Command="{Binding DataContext.ReplyToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CommentStatus}" Foreground="#80FFFFFF" FontSize="10.5"
                                       Margin="0,0,0,5" Visibility="{Binding CommentStatus, Converter={StaticResource NotEmptyToVis}}" />
                            <Border Background="#334EA4DD" CornerRadius="8" Padding="8,3" Margin="0,0,0,6"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReplyTargetName, StringFormat=回复 @{0}}" Foreground="#99FFFFFF"
                                               FontSize="10.5" VerticalAlignment="Center" />
                                    <Button Content="取消" Style="{StaticResource LinkButton}" Height="16" Padding="0"
                                            Margin="8,0,0,0" FontSize="10" Foreground="#CCFFFFFF"
                                            Command="{Binding CancelReplyCommand}" />
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="16" Background="#26FFFFFF" Padding="10,4" VerticalAlignment="Center">
                                    <TextBox Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" MinHeight="36" MaxHeight="80" Background="Transparent" Foreground="White"
                                             BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Center" Padding="0" FontSize="12" />
                                </Border>
                                <Button Grid.Column="1" Content="发送" Height="40" Width="62" Padding="0" Margin="8,0,0,0"
                                        Background="#4EA4DD" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding SendCommentCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 视频评论图片灯箱：与帖子阅读器一致，可缩放/拖动/下载 -->
        <Grid x:Name="CommentLightbox" Background="#DD000000" Visibility="Collapsed">
            <ScrollViewer x:Name="CommentLightboxScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Padding="56" Cursor="Hand"
                          PreviewMouseWheel="CommentLightbox_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="CommentLightbox_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="CommentLightbox_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="CommentLightbox_PreviewMouseLeftButtonUp">
                <Image x:Name="CommentLightboxImage" Stretch="Uniform" MaxWidth="1600" MaxHeight="1200"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CommentLightboxScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="CommentLightboxTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer>
            <Button x:Name="CommentLightboxPrev" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="18,0,0,0" Cursor="Hand" Click="CommentLightboxPrev_Click" ToolTip="上一张图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#33FFFFFF">
                            <Path Data="M7 0 L0 7 L7 14" Stroke="White" StrokeThickness="1.8" Width="8" Height="15" Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CommentLightboxNext" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,18,0" Cursor="Hand" Click="CommentLightboxNext_Click" ToolTip="下一张图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#33FFFFFF">
                            <Path Data="M0 0 L7 7 L0 14" Stroke="White" StrokeThickness="1.8" Width="8" Height="15" Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="CommentLightboxCounter" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,22" Foreground="#B3FFFFFF" FontSize="12" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,12"
                    Width="36" Height="36" Padding="0" Cursor="Hand" Click="CommentLightboxDownload_Click"
                    Background="#33FFFFFF" BorderThickness="0" ToolTip="下载图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="18">
                            <Path Data="M1 10 V14 H15 V10 M8 1 V10 M5 7 L8 10 L11 7" Stroke="White"
                                  StrokeThickness="1.4" Width="15" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="CommentLightboxStatus" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,26,0,0" Foreground="#CCFFFFFF" FontSize="11.5" />
            <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                    Cursor="Hand" Click="CloseCommentLightbox_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="20" Background="#33FFFFFF">
                            <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="White" StrokeThickness="1.6"
                                  Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
