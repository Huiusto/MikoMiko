<UserControl x:Class="MikoMiko.Views.AnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <DataTemplate x:Key="AnimeCard">
            <Button Style="{StaticResource CardButton}" Width="148" Margin="0,0,14,18"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="198">
                        <Border CornerRadius="10" ClipToBounds="True" Background="#E8F4FC">
                            <Grid>
                                <Image Source="pack://application:,,,/Assets/Demo/placeholder.png" Stretch="UniformToFill" />
                                <Image controls:AsyncImage.Url="{Binding Poster}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <Border Height="52" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#B3001824" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Background="#E6F4FB" CornerRadius="6" Padding="6,2" Margin="8,8,8,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#2F86B9" />
                        </Border>
                        <Border Background="#66000000" CornerRadius="5" Padding="5,2" Margin="0,0,8,8"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right" IsHitTestVisible="False"
                                Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Text="{Binding Note}" FontSize="9.5" Foreground="White" TextTrimming="CharacterEllipsis"
                                       MaxWidth="78" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="2,8,2,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Kind}" FontSize="10.5" Margin="2,3,2,0"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SmallAnimeCard">
            <Button Style="{StaticResource CardButton}" Width="132" Margin="0,0,12,0"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="172" CornerRadius="9" ClipToBounds="True" Background="#E8F4FC">
                        <Grid>
                            <Image controls:AsyncImage.Url="{Binding Poster}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Height="36" VerticalAlignment="Bottom" Background="#99001824" />
                            <TextBlock Text="{Binding Note}" Foreground="White" FontSize="10"
                                       VerticalAlignment="Bottom" Margin="8,0,8,7" TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="1,7,1,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FilterChip">
            <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                    Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 模块内的独立搜索框：进入追番/影视后，页头全局搜索框隐藏。 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <Grid Margin="26,11,20,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="460" Height="36" CornerRadius="18" Background="#EEF8FE"
                            BorderBrush="#D8ECF9" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                                  Stroke="#5AA9D6" StrokeThickness="1.4" Width="16" Height="16"
                                  Stretch="Uniform" Margin="13,0,8,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AnimeSearch" Style="{StaticResource SearchBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="AnimeSearch_KeyDown" Margin="0,0,4,0" VerticalAlignment="Center"
                                         IsEnabled="{Binding IsInstalled}" />
                                <TextBlock Text="搜索番剧、电影、电视剧" Foreground="{DynamicResource Brush.TextTertiary}"
                                           FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AnimeSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Width="26" Height="26"
                                    Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}}"
                                    ToolTip="清空">
                                <Path Data="M0 0 L9 9 M9 0 L0 9" Stroke="{DynamicResource Brush.TextTertiary}"
                                      StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource ChipButton}" Content="搜索" Height="36" Margin="10,0,0,0"
                            Padding="18,0" Command="{Binding SearchCommand}" IsEnabled="{Binding IsInstalled}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ShowHomeCommand}" Margin="0,0,14,0"
                            Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 3 L3 8 L8 13" Stroke="#4EA4DD" StrokeThickness="1.4"
                                  Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="返回首页" FontSize="12" Foreground="#4EA4DD" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Background="#E6F4FB" CornerRadius="7" Padding="9,5" Margin="0,0,10,0"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#4EA4DD" VerticalAlignment="Center" />
                            <TextBlock Text="独立模块已安装" FontSize="10.5" Foreground="#2F86B9" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource LinkButton}" Command="{Binding UninstallModuleCommand}"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                            ToolTip="删除 modules\anime 下的独立模块，可再次下载">
                        <TextBlock Text="卸载模块" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="AnimeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel Margin="26,18,18,30">

                <!-- ==================== 未下载：蓝白软萌下载引导页 ==================== -->
                <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                    <Border Height="438" CornerRadius="18" ClipToBounds="True" Background="#F8FCFF">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/Anime/anime-hero.png" Height="438"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Width="620" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F8FCFF" Offset="0" />
                                        <GradientStop Color="#E6F6FF" Offset="0.42" />
                                        <GradientStop Color="#66F2FAFF" Offset="0.74" />
                                        <GradientStop Color="#00F8FCFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="420" HorizontalAlignment="Left" Margin="40,42,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Background="#E6F4FB" CornerRadius="7" Padding="9,4" HorizontalAlignment="Left">
                                        <TextBlock Text="可独立下载 / 卸载" FontSize="10.5" Foreground="#2F86B9" />
                                    </Border>
                                    <TextBlock Text="追番 / 影视" FontSize="36" FontWeight="Bold" Margin="0,14,0,0"
                                               Foreground="#1E3A4F" />
                                    <TextBlock Text="一次下载，聚合樱花TV、PIDEC、南瓜电影等九个站点" FontSize="13"
                                               LineHeight="21" Foreground="#587183" Margin="0,10,0,0"
                                               TextWrapping="Wrap" MaxWidth="360" />
                                </StackPanel>
                            </Border>

                            <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                                <Button Command="{Binding DownloadModuleCommand}" Cursor="Hand"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" Height="52" CornerRadius="26" BorderThickness="1"
                                                    BorderBrush="#7BC3EA">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#8CCEF3" Offset="0" />
                                                        <GradientStop Color="#4EA4DD" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="M9 1 V13 M4 8 L9 13 L14 8 M2 16 H16"
                                                          Stroke="White" StrokeThickness="1.8" Width="15" Height="15"
                                                          Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="下载 追番/影视 板块" Foreground="White" FontSize="15"
                                                               FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border Background="#EAF6FD" CornerRadius="9" Padding="14,10"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="正在下载追番/影视模块…" FontSize="11.5" Foreground="#2F86B9" />
                                            <TextBlock Text="{Binding DownloadPercentText}" FontSize="11" Foreground="#2F86B9"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding DownloadProgress}" Foreground="#4EA4DD"
                                                     Background="#D8ECF9" BorderThickness="0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#6C8FA5" Margin="0,9,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                           Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="2,16,0,10">
                        <TextBlock Text="九个追番 / 影视数据源" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="未下载模块也可以先打开站点" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PreviewProviders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Padding="13,7"
                                        Command="{Binding DataContext.OpenProviderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M2 2 H12 V12 H2 Z M8 2 V12 M2 7 H12" Stroke="{DynamicResource Brush.Accent}"
                                              StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="模块独立存放在应用数据目录，卸载时整目录删除，不影响推荐、帖子与视频。"
                               FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,12,0,0" />
                </StackPanel>

                <!-- ==================== 已下载：影视首页 ==================== -->
                <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                    <Grid Visibility="{Binding IsMorePage, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <Border Height="252" CornerRadius="16" ClipToBounds="True" Background="#DDEFFB">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/Anime/anime-hero.png" Stretch="UniformToFill"
                                           Opacity="0.72" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <BlurEffect Radius="24" />
                                        </Image.Effect>
                                    </Image>
                                    <Image controls:AsyncImage.Url="{Binding Hero.Poster}" Stretch="UniformToFill"
                                           Opacity="0.92" RenderOptions.BitmapScalingMode="HighQuality"
                                           controls:AsyncImage.Fallback="pack://application:,,,/Assets/Anime/anime-hero.png">
                                        <Image.Effect>
                                            <BlurEffect Radius="9" />
                                        </Image.Effect>
                                    </Image>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#F8FCFF" Offset="0" />
                                                <GradientStop Color="#EDF8FF" Offset="0.36" />
                                                <GradientStop Color="#CCD2EAF8" Offset="0.7" />
                                                <GradientStop Color="#59BEDCF0" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="36,30,34,26">
                                        <StackPanel Width="470" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Background="#D8ECF9" CornerRadius="7" Padding="9,4"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="热门追番" FontSize="10.5" Foreground="#2F86B9" />
                                            </Border>
                                            <TextBlock Text="{Binding Hero.Title}" FontSize="31" FontWeight="Bold"
                                                       Foreground="#1E3A4F" Margin="0,13,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="46" />
                                            <TextBlock Text="{Binding Hero.MetaText}" FontSize="12" Foreground="#587183"
                                                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <Button Command="{Binding OpenItemCommand}" CommandParameter="{Binding Hero}"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border Background="#4EA4DD" CornerRadius="18" Padding="20,9">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="M0 0 L8 4.6 L0 9.2 Z" Fill="White" Width="8" Height="9"
                                                                          Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="立即观看" Foreground="White" FontSize="12.5"
                                                                               Margin="6,0,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.88" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="内容来自第三方站点，点击在软件内打开" FontSize="10.5"
                                                           Foreground="#6C8FA5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="2,18,0,10">
                                <TextBlock Text="今日更新" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Featured}" ItemTemplate="{StaticResource SmallAnimeCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Grid Margin="2,22,0,10">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Command="{Binding ShowMoreCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="查看更多" FontSize="11.5" Foreground="#4EA4DD" />
                                        <Path Data="M0 0 L5 5 L0 10" Stroke="#4EA4DD" StrokeThickness="1.3"
                                              Width="5" Height="10" Stretch="Uniform" Margin="5,0,0,0"
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== 查看更多：多维筛选页 ==================== -->
                    <StackPanel Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="#E3F1FA"
                                BorderThickness="1" CornerRadius="12" Padding="18,15,18,8" Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeFilters}" ItemTemplate="{StaticResource FilterChip}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="排序" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SortFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                                        Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="地区" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding RegionFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                                        Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="来源" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SourceFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                                        Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,0,0,10">
                            <TextBlock Text="{Binding SectionTitle}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="120" Height="5" IsIndeterminate="True" Foreground="#4EA4DD"
                                         Background="#D8ECF9" BorderThickness="0" VerticalAlignment="Center" />
                            <TextBlock Text="正在聚合数据源…" FontSize="11.5" Foreground="#6C8FA5" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AnimeCard}"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="#E3F1FA" BorderThickness="1"
                            CornerRadius="12" Padding="26,30" Margin="2,5,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M2 4 H16 V15 H2 Z M2 8 H16 M7 4 V2 H11 V4" Stroke="#7DBFE3"
                                  StrokeThickness="1.4" Width="30" Height="26" Stretch="Uniform" />
                            <TextBlock Text="暂时没有匹配的作品" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="可以切换筛选条件，或直接打开数据源站点。" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="2,24,0,10">
                        <TextBlock Text="数据源" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="点击在软件内打开对应站点" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Padding="13,7"
                                        Command="{Binding DataContext.OpenProviderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#4EA4DD" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
