<UserControl x:Class="MikoMiko.Views.AnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <DataTemplate x:Key="PosterCard">
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,24"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="266" CornerRadius="14" ClipToBounds="True" Background="#E8F3FB">
                        <Grid>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#5E8298"
                                       TextWrapping="Wrap" Margin="18,0" TextAlignment="Center" VerticalAlignment="Center"
                                       MaxHeight="100" />
                            <Image controls:AsyncImage.Url="{Binding Poster}"
                                   controls:AsyncImage.Referer="{Binding PosterReferer}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Height="86" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#D600101B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="#EEFFFFFF" Margin="11,0,10,10"
                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}" />
                            <Border Background="#D900101B" CornerRadius="10" Padding="8,2" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Kind}" FontSize="9.5" Foreground="#F2FFFFFF" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="1,9,1,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding MetaText}" FontSize="10.5" Margin="1,5,1,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#617687" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="#F6F8FA" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#ECF7FE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#DFF2FE" />
                                <Setter Property="Foreground" Value="#2F86B9" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7E94A4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">

        <!-- ==================== 未下载：用户原图居中完整展示，不裁切、不重绘 ==================== -->
        <Grid Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
              Background="#F8FBFE" ClipToBounds="True">
            <Border Margin="26" Background="White" CornerRadius="20" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas Width="1672" Height="941">
                        <Image Source="pack://application:,,,/Assets/Anime/anime-download.png"
                               Canvas.Left="0" Canvas.Top="0" Width="1672" Height="941"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- 原图中的大胶囊按钮位置覆盖透明点击区 -->
                        <Button Canvas.Left="150" Canvas.Top="500" Width="1410" Height="220"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding DownloadModuleCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 下载进度覆盖在同一胶囊位置 -->
                        <Border Canvas.Left="185" Canvas.Top="540" Width="1300" Height="150"
                                CornerRadius="75" Background="#F2FFFFFF"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" Margin="42,0">
                                <Grid>
                                    <TextBlock Text="正在下载追番/影视板块…" FontSize="17" Foreground="#2F86B9" />
                                    <TextBlock Text="{Binding DownloadPercentText}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#2F86B9" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="11" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" Foreground="#4EA4DD"
                                             Background="#E2F3FD" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Canvas.Left="0" Canvas.Top="874" Width="1672" Text="{Binding StatusText}"
                                   FontSize="13" Foreground="#C05050" TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>

        <!-- ==================== 已下载：搜索栏 + 首页 / 全部内容 ==================== -->
        <Grid Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部白色搜索条 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#EAF2F8" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,22,0">
                    <Border Width="600" Height="38" CornerRadius="19" Background="#F7F9FB"
                            BorderBrush="#E7EDF3" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                                  Stroke="#8CA1B0" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"
                                  Margin="16,0,10,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AnimeSearch" Style="{StaticResource SearchBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="AnimeSearch_KeyDown" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0" />
                                <TextBlock Text="搜索番剧、电影、电视剧" Foreground="#94A6B4" FontSize="12.5"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AnimeSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                                    Margin="0,0,2,0" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}}" ToolTip="清空">
                                <Path Data="M0 0 L9 9 M9 0 L0 9" Stroke="#72899A"
                                      StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource LinkButton}" Width="44"
                                    Command="{Binding SearchCommand}" ToolTip="搜索">
                                <Path Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                                      Stroke="#405A6B" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Height="30" Padding="12,0"
                                Command="{Binding RefreshCommand}" ToolTip="刷新内容">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8 2 A6 6 0 1 0 8 14 M8 2 L12 2 M8 2 L8 6"
                                      Stroke="#7D94A6" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="刷新" FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" Height="30" Padding="10,0" Margin="6,0,0,0"
                                Command="{Binding UninstallModuleCommand}" ToolTip="卸载追番/影视模块">
                            <TextBlock Text="卸载模块" FontSize="10.5" Foreground="#8CA0AF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="AnimeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,32">

                    <!-- 首页装饰横幅：取自用户提供的图 2，不叠加任何文字 -->
                    <Border Height="224" CornerRadius="16" ClipToBounds="True" Background="#EAF6FE"
                            Visibility="{Binding IsMorePage, Converter={StaticResource InverseBoolToVis}}">
                        <Image Source="pack://application:,,,/Assets/Anime/anime-home-hero.png"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- 页面标题 / 查看全部 / 返回首页 -->
                    <Grid Margin="0,22,0,15">
                        <TextBlock Text="{Binding SectionTitle}" FontSize="25" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountText}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,0,12,0" VerticalAlignment="Center"
                                       Visibility="{Binding CountText, Converter={StaticResource NotEmptyToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                    Command="{Binding ShowMoreCommand}"
                                    Visibility="{Binding IsMorePage, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="查看全部" FontSize="11.5" VerticalAlignment="Center" />
                                    <Path Data="M0 0 L5 5 L0 10" Stroke="{DynamicResource Brush.TextSecondary}"
                                          StrokeThickness="1.3" Width="4" Height="9" Stretch="Uniform"
                                          Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="返回首页" Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                    Command="{Binding ShowHomeCommand}"
                                    Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- 查看全部：类型 / 排序 / 地区 / 风格 -->
                    <Border Background="White" BorderBrush="#EDF3F8" BorderThickness="1" CornerRadius="14"
                            Padding="18,16,14,8" Margin="0,0,0,20"
                            Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="类型" Style="{StaticResource FilterLabel}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource FilterChip}"
                                                    Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="排序" Style="{StaticResource FilterLabel}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SortFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource FilterChip}"
                                                    Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地区" Style="{StaticResource FilterLabel}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding RegionFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource FilterChip}"
                                                    Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="风格" Style="{StaticResource FilterLabel}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GenreFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource FilterChip}"
                                                    Command="{Binding DataContext.SelectGenreCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Width="110" Height="4" IsIndeterminate="True" Foreground="#4EA4DD"
                                     Background="#D8ECF9" BorderThickness="0" VerticalAlignment="Center" />
                        <TextBlock Text="正在聚合九个站点…" FontSize="11" Foreground="#6C8FA5" Margin="10,0,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterCard}"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="White" BorderBrush="#E3F1FA" BorderThickness="1"
                            CornerRadius="14" Padding="28,34" Margin="0,8,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M2 4 H16 V15 H2 Z M2 8 H16 M7 4 V2 H11 V4" Stroke="#7DBFE3"
                                  StrokeThickness="1.4" Width="30" Height="26" Stretch="Uniform" />
                            <TextBlock Text="暂时没有匹配的作品" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="可以换个分类或关键词试试。" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="#C05050"
                               TextWrapping="Wrap" Margin="2,4,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
