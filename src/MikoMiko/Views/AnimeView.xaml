<UserControl x:Class="MikoMiko.Views.AnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <DataTemplate x:Key="PosterCard">
            <Button Style="{StaticResource CardButton}" Margin="0,0,15,24"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="228" CornerRadius="12" ClipToBounds="True" Background="#E8F3FB">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#D7ECFA" Offset="0" />
                                        <GradientStop Color="#BBDDF2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#5E8298"
                                       TextWrapping="Wrap" Margin="16,0" TextAlignment="Center" VerticalAlignment="Center"
                                       MaxHeight="90" />
                            <Image controls:AsyncImage.Url="{Binding Poster}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Height="76" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#C400101B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Note}" FontSize="10" Foreground="#EEFFFFFF" Margin="10,0,10,9"
                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}" />
                            <Border Background="#C900101B" CornerRadius="9" Padding="7,2" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Kind}" FontSize="9.5" Foreground="#F2FFFFFF" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="1,9,1,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Kind}" FontSize="10.5" Margin="1,5,1,0"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="HeroCard">
            <Button Style="{StaticResource CardButton}" Margin="0,0,10,0"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}">
                <Border Height="86" CornerRadius="10" ClipToBounds="True" Background="#22364A">
                    <Grid>
                        <TextBlock Text="{Binding Title}" FontSize="10" Foreground="#CFE4F1" TextWrapping="Wrap"
                                   Margin="8,6" TextAlignment="Center" VerticalAlignment="Center" MaxHeight="50" />
                        <Image controls:AsyncImage.Url="{Binding Poster}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Height="32" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E600101B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="#F6FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                   Margin="7,0,7,7" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="12.5" Width="20" Margin="0,0,9,0"
                                           Foreground="#8AA3B5" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F4EA4DD" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#124EA4DD" />
                                <Setter Property="Foreground" Value="#2F86B9" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">

        <!-- ==================== 未下载：软萌角色 + 一个下载按钮 ==================== -->
        <Grid Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
              Background="#FBFDFF" ClipToBounds="True">
            <!-- 浅蓝软装饰 -->
            <Canvas>
                <Ellipse Width="520" Height="380" Canvas.Left="-150" Canvas.Top="-160">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#BFE5FA" Offset="0" />
                            <GradientStop Color="#EBF7FF" Offset="0.62" />
                            <GradientStop Color="#00EBF7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="560" Height="420" Canvas.Right="-190" Canvas.Bottom="-190">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#CBE9FB" Offset="0" />
                            <GradientStop Color="#00E8F6FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="26" Height="26" Canvas.Left="250" Canvas.Top="168" Fill="#6DB8E8" Opacity="0.55" />
                <Ellipse Width="12" Height="12" Canvas.Left="214" Canvas.Top="290" Fill="#A3D6F3" />
                <Ellipse Width="16" Height="16" Canvas.Left="905" Canvas.Top="236" Fill="#5EADE0" Opacity="0.6" />
                <Path Data="M8 0 L10.2 6.8 L17 9 L10.2 11.2 L8 18 L5.8 11.2 L-1 9 L5.8 6.8 Z"
                      Fill="#8ACDF2" Width="26" Height="26" Stretch="Uniform"
                      Canvas.Left="300" Canvas.Top="132" Opacity="0.9" />
                <Path Data="M8 0 L10.2 6.8 L17 9 L10.2 11.2 L8 18 L5.8 11.2 L-1 9 L5.8 6.8 Z"
                      Fill="#B7DFF7" Width="18" Height="18" Stretch="Uniform"
                      Canvas.Left="838" Canvas.Top="152" Opacity="0.9" />
                <Path Data="M4 0 H18 M4 6 H18 M4 12 H18" Stroke="#7FC4EC" StrokeThickness="4"
                      Width="28" Height="20" Stretch="Uniform" Canvas.Left="886" Canvas.Top="134" Opacity="0.5" />
            </Canvas>

            <Grid Width="840" Height="640" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 下载按钮：白描边 + 浅蓝外圈 + 大圆角 -->
                <Button Command="{Binding DownloadModuleCommand}" Cursor="Hand"
                        Width="640" Height="112" VerticalAlignment="Bottom" Margin="0,0,0,146"
                        Panel.ZIndex="1"
                        Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="56" Padding="7" Background="#D9EFFC"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.18" Color="#5B9BC4" />
                                </Border.Effect>
                                <Border CornerRadius="49" Background="#FFFFFF" Padding="5">
                                    <Border CornerRadius="44">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#82CBF2" Offset="0" />
                                                <GradientStop Color="#5AAFE5" Offset="0.5" />
                                                <GradientStop Color="#4EA4DD" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="下载 追番/影视 板块" Foreground="White" FontSize="28"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                            <Path Data="M11 2 V16 M5 10 L11 16 L17 10 M3 21 H19"
                                                  Stroke="White" StrokeThickness="2.6" Width="34" Height="34"
                                                  Stretch="Uniform" Margin="24,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 下载进度：同样是一个大胶囊 -->
                <Border Width="640" Height="112" CornerRadius="56" Padding="7" Background="#D9EFFC"
                        VerticalAlignment="Bottom" Margin="0,0,0,146" Panel.ZIndex="1"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="49" Background="White" Padding="26,16">
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="正在下载追番/影视模块…" FontSize="13" Foreground="#2F86B9" />
                                <TextBlock Text="{Binding DownloadPercentText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#2F86B9" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="9" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadProgress}" Foreground="#4EA4DD"
                                         Background="#E2F3FD" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 角色压在按钮上沿 -->
                <Image Source="pack://application:,,,/Assets/Anime/anime-mascot.png"
                       Width="520" Height="520" Stretch="Uniform"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       Margin="0,10,0,0" Panel.ZIndex="2"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#C05050"
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
            </Grid>
        </Grid>

        <!-- ==================== 已下载：原生影视首页 ==================== -->
        <Grid Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 首页 Hero：满幅剧照 + 顶部悬浮搜索 + 底部更新横排 -->
            <Grid Grid.Row="0" Height="430" ClipToBounds="True" Background="#111E29"
                  Visibility="{Binding IsMorePage, Converter={StaticResource InverseBoolToVis}}">
                <Image controls:AsyncImage.Url="{Binding Hero.Poster}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       controls:AsyncImage.Fallback="pack://application:,,,/Assets/Anime/anime-hero.png" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#D9091420" Offset="0" />
                            <GradientStop Color="#8C071422" Offset="0.36" />
                            <GradientStop Color="#1A071422" Offset="0.7" />
                            <GradientStop Color="#00071422" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border VerticalAlignment="Top" Height="76">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#59000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border VerticalAlignment="Bottom" Height="190">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00091420" Offset="0" />
                            <GradientStop Color="#B8091420" Offset="0.55" />
                            <GradientStop Color="#EA091420" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 搜索框只在安装后出现 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="560" Height="38"
                        Margin="0,18,0,0" CornerRadius="19" Background="#E8FFFFFF"
                        BorderBrush="#66FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#0A2233" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                              Stroke="#6B8799" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"
                              Margin="16,0,10,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="AnimeSearch" Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="AnimeSearch_KeyDown" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" />
                            <TextBlock Text="搜索番剧、电影、电视剧" Foreground="#7C94A4" FontSize="12.5"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AnimeSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                                Margin="0,0,3,0" Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}}" ToolTip="清空">
                            <Path Data="M0 0 L9 9 M9 0 L0 9" Stroke="#6B8799"
                                  StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource LinkButton}" Width="42"
                                Command="{Binding SearchCommand}" ToolTip="搜索">
                            <Path Data="M3 3 A7 7 0 1 0 3 17 A7 7 0 1 0 3 3 M8.6 8.6 L14 14"
                                  Stroke="#405A6B" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,24,0" Command="{Binding UninstallModuleCommand}" ToolTip="卸载追番/影视模块">
                    <TextBlock Text="卸载模块" FontSize="10.5" Foreground="#DFFFFFFF" />
                </Button>

                <!-- 标题 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="620"
                            Margin="34,0,0,142">
                    <Border Background="#CC4EA4DD" CornerRadius="7" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="正在热播" FontSize="10" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding HeroTitle}" FontSize="38" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="White" TextTrimming="CharacterEllipsis" MaxHeight="54">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.36" Color="#03101A" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding HeroMeta}" FontSize="12.5" Foreground="#E4F3FC" Margin="1,7,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右下角播放与收藏 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,30,136">
                    <Button Cursor="Hand" Command="{Binding OpenItemCommand}" CommandParameter="{Binding Hero}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#D90B1822" CornerRadius="19" Padding="5,5,18,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#F0A23B">
                                            <Path Data="M0 0 L9 5.4 L0 10.8 Z" Fill="White" Width="9" Height="11"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding DataContext.HeroTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   Foreground="#F4FFFFFF" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="9,0,0,0" MaxWidth="280"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Path Data="M0 0 L6 6 L0 12" Stroke="#B9D2DF" StrokeThickness="1.2"
                                              Width="6" Height="12" Stretch="Uniform" Margin="12,0,0,0"
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.92" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="36" Height="36" Margin="10,0,0,0" Cursor="Hand" ToolTip="收藏">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#B30B1822" CornerRadius="18" BorderBrush="#4DFFFFFF" BorderThickness="1">
                                    <Path Data="M9 16 C4 12 1 8.8 1 5.6 C1 3 3.1 1.2 5.6 1.2 C7.2 1.2 8.5 2.1 9 3.2 C9.5 2.1 10.8 1.2 12.4 1.2 C14.9 1.2 17 3 17 5.6 C17 8.8 14 12 9 16 Z"
                                          Fill="#E8FFFFFF" Width="16" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 今日更新横排 -->
                <ItemsControl ItemsSource="{Binding Featured}" ItemTemplate="{StaticResource HeroCard}"
                              VerticalAlignment="Bottom" Margin="30,0,30,14" Height="90">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- 分类栏 + 内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                        Background="{DynamicResource Brush.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,18,10,14">
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}" Content="{Binding Label}"
                                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="20,10,14,18">
                            <TextBlock Text="九个站点" FontSize="10.5" Foreground="#9AAAB6" />
                            <TextBlock Text="全部在软件内打开与播放" FontSize="10.5" Foreground="#9AAAB6"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Width="104" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="AnimeScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,20,28,30">
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="{Binding SectionTitle}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Height="30" Padding="13,0"
                                        Command="{Binding ShowMoreCommand}"
                                        Visibility="{Binding IsMorePage, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="查看全部" FontSize="11" VerticalAlignment="Center" />
                                        <Path Data="M0 0 L5 5 L0 10" Stroke="{DynamicResource Brush.TextSecondary}"
                                              StrokeThickness="1.3" Width="4" Height="9" Stretch="Uniform"
                                              Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="返回首页" Style="{StaticResource GhostButton}" Height="30" Padding="13,0"
                                        Command="{Binding ShowHomeCommand}"
                                        Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="110" Height="4" IsIndeterminate="True" Foreground="#4EA4DD"
                                         Background="#D8ECF9" BorderThickness="0" VerticalAlignment="Center" />
                            <TextBlock Text="正在聚合九个站点…" FontSize="11" Foreground="#6C8FA5" Margin="10,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterCard}"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="#E3F1FA" BorderThickness="1"
                                CornerRadius="14" Padding="28,34" Margin="0,8,0,0"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M2 4 H16 V15 H2 Z M2 8 H16 M7 4 V2 H11 V4" Stroke="#7DBFE3"
                                      StrokeThickness="1.4" Width="30" Height="26" Stretch="Uniform" />
                                <TextBlock Text="暂时没有匹配的作品" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="可以换个分类或关键词试试。" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
