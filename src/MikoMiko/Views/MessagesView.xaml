<UserControl x:Class="MikoMiko.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <UserControl.Resources>
        <Style x:Key="MessageCardStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NotificationTemplate">
            <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Padding="16,14" Margin="0,0,0,10" Cursor="Hand"
                    Tag="{Binding ActionUrl}" MouseLeftButtonUp="Notification_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="40" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource Brush.AccentSoft}"/>
                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FF5C7A" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Visibility="{Binding UnreadVisibility}"/>
                            <TextBlock Text="{Binding Nickname}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding ActionText}" FontSize="12" Margin="7,1,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" FontSize="13.5" LineHeight="22" Margin="0,7,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" MaxHeight="88"/>
                        <Border CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Padding="12,9"
                                Margin="0,9,0,0" Visibility="{Binding OriginVisibility}">
                            <TextBlock Text="{Binding Origin}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSecondary}" MaxHeight="62"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Left" Margin="30,24,30,34">

                <Grid>
                    <StackPanel>
                        <TextBlock Text="消息" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="已同步当前登录的米游社账号" FontSize="12.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                    <Button x:Name="AllReadButton" Content="全部已读" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="16,8" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" Style="{StaticResource PlainButtonStyle}"
                            Click="AllRead_Click"/>
                </Grid>

                <Border CornerRadius="14" Margin="0,20,0,0" Padding="22,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4EA4DD" Offset="0"/>
                            <GradientStop Color="#7CC6EA" Offset="0.55"/>
                            <GradientStop Color="#B8E3F7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="米游社消息中心" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="回复、@ 我、收到的赞与系统通知，与米游社网页端实时同步。"
                                       FontSize="12.5" Margin="0,7,0,0" Foreground="#F2FAFF"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开米游社" VerticalAlignment="Center"
                                Padding="16,8" FontSize="12.5" Foreground="#1C5A85" Background="White"
                                BorderThickness="0" Style="{StaticResource PlainButtonStyle}"
                                Click="OpenCenter_Click"/>
                    </Grid>
                </Border>

                <UniformGrid Columns="4" Margin="0,16,0,0">
                    <Button x:Name="ReplyCard" Tag="reply" Click="Category_Click" Margin="0,0,10,0"
                            Style="{StaticResource MessageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#4EA4DD" HorizontalAlignment="Left">
                                    <TextBlock Text="回" FontSize="13" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ReplyCount" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="回复我的" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="评论与楼层回复" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AtCard" Tag="active_mention" Click="Category_Click" Margin="0,0,10,0"
                            Style="{StaticResource MessageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#F2A65A" HorizontalAlignment="Left">
                                    <TextBlock Text="@" FontSize="14" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="AtCount" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="主动 @ 我" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="帖子与评论中的提及" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LikeCard" Tag="comment" Click="Category_Click" Margin="0,0,10,0"
                            Style="{StaticResource MessageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#7BC5A3" HorizontalAlignment="Left">
                                    <TextBlock Text="赞" FontSize="13" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="LikeCount" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="收到的赞" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="帖子与评论被点赞" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SystemCard" Tag="system" Click="Category_Click"
                            Style="{StaticResource MessageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#9A93D8" HorizontalAlignment="Left">
                                    <TextBlock Text="铃" FontSize="13" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SystemCount" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="系统通知" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="官方公告与账号消息" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Margin="2,24,0,10">
                    <TextBlock x:Name="ListTitle" Text="回复我的" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock x:Name="ListHint" Text="" FontSize="12" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>

                <ItemsControl x:Name="NotificationList" ItemTemplate="{StaticResource NotificationTemplate}"/>

                <Border x:Name="EmptyPanel" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="40" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle" Text="暂无消息" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock x:Name="EmptyHint" Text="登录米游社后，最新消息会自动同步到这里。"
                                   FontSize="12.5" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Text="" FontSize="12" Margin="2,12,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
