<UserControl x:Class="MikoMiko.Views.WebHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="{DynamicResource Font.Ui}">
    <UserControl.Resources>
        <Style x:Key="ToolIconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SiteItem">
            <Button Width="292" Margin="0,0,10,6" Cursor="Hand" Click="Site_Click"
                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="11,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Note}" FontSize="10.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ToolIconButton}" Click="Back_Click" ToolTip="后退">
                    <Path Data="M13 2 L5 10 L13 18" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="20" Stretch="Uniform" />
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ToolIconButton}" Click="Forward_Click" ToolTip="前进" Margin="2,0,0,0">
                    <Path Data="M5 2 L13 10 L5 18" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="20" Stretch="Uniform" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ToolIconButton}" Click="Reload_Click" ToolTip="刷新" Margin="2,0,0,0">
                    <Path Data="M7 1 A6 6 0 1 0 13 6 M13 6 V2.2 M13 6 H9.2" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource ToolIconButton}" Click="Home_Click" ToolTip="回到米游社" Margin="2,0,8,0">
                    <Path Data="M2 10 L9 3 L16 10 M4 9 V16 H14 V9" Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                </Button>

                <Border Grid.Column="4" Height="34" CornerRadius="9" Background="{DynamicResource Brush.SearchBg}"
                        VerticalAlignment="Center" Margin="4,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressInput" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                 VerticalContentAlignment="Center" Padding="12,0,4,0"
                                 KeyDown="AddressInput_KeyDown" GotKeyboardFocus="AddressInput_GotFocus" />
                        <Button Grid.Column="1" Style="{StaticResource ToolIconButton}" Width="30" Height="30"
                                Margin="0,0,3,0" Click="Go_Click" ToolTip="前往">
                            <Path Data="M2 8 H14 M9 3 L14 8 L9 13" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Button AutomationProperties.Name="推荐网页" x:Name="BtnLinks" Grid.Column="5" Height="34" Cursor="Hand" Click="Links_Click"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" Padding="14,0" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M2 3 H15 M2 8 H15 M2 13 H15" Stroke="{DynamicResource Brush.TextSecondary}"
                                          StrokeThickness="1.3" Width="15" Height="13" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="推荐网页" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <Path Data="M0 0 L5 5 L10 0" Stroke="{DynamicResource Brush.TextTertiary}"
                                          StrokeThickness="1.3" Width="9" Height="5" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#FFFFFFFF">
            <wv2:WebView2 x:Name="Web" Loaded="Web_Loaded" />
            <Border x:Name="LoadingPanel" Background="#FFFFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在软件内加载网页…" Foreground="#66707A" FontSize="13" HorizontalAlignment="Center" />
                    <TextBlock Text="默认打开米游社「大别野」" Foreground="#98A1AA" FontSize="11.5"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Popup x:Name="LinksPopup" PlacementTarget="{Binding ElementName=BtnLinks}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="7"
               HorizontalOffset="-772">
            <Border Width="940" MaxHeight="600" Background="{DynamicResource Brush.WindowBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,14,4,12">
                        <TextBlock Text="米哈游相关" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="4,0,0,7" />
                        <ItemsControl x:Name="OfficialLinks" ItemTemplate="{StaticResource SiteItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="4,8,14,12" />

                        <TextBlock Text="第三方工具" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="4,0,0,7" />
                        <ItemsControl x:Name="ThirdPartyLinks" ItemTemplate="{StaticResource SiteItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
