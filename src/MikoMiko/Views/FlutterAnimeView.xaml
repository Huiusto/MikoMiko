<UserControl x:Class="MikoMiko.Views.FlutterAnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Background="#F5FAFD">
        <wv2:WebView2 x:Name="Web" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      DefaultBackgroundColor="#F5FAFD" />

        <Border x:Name="LoadingPanel" Background="#F5FAFD">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="18" Background="#DFF2FE"
                        HorizontalAlignment="Center">
                    <Path Data="M8 4 L20 12 L8 20 Z" Fill="#2F86B9" Width="18" Height="20"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="正在启动 Flutter 追番模块…" FontSize="13" Foreground="#2F86B9"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="LoadingDetail" Text="加载规则引擎与内置规则"
                           FontSize="10.5" Foreground="#8CA1B0" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="ToastPanel" Background="#EE102B3D" CornerRadius="10" Padding="15,9"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="11.5" TextWrapping="Wrap" MaxWidth="560" />
        </Border>
    </Grid>
</UserControl>
