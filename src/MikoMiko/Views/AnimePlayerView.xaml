<UserControl x:Class="MikoMiko.Views.AnimePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Background="#0B1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111925" BorderBrush="#223247" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="28" Height="28" CornerRadius="8" Background="#1B2A3D" VerticalAlignment="Center">
                    <TextBlock Text="▶" FontSize="12" Foreground="#7CC4F2"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="#F2F7FB"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" FontSize="11" Foreground="#8AA3B8" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1B2A3D" CornerRadius="9" Padding="9,4" Margin="0,0,10,0">
                        <TextBlock x:Name="ModeText" FontSize="10.5" Foreground="#8FD3F4" />
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="30"
                            Click="Close_Click" ToolTip="{Binding [Common.Close], Source={x:Static loc:Loc.Instance}}">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="#F2F7FB"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#000000">
            <wv2:WebView2 x:Name="Web" Loaded="Web_Loaded" />
            <Border x:Name="LoadingPanel" Background="#0B1018" Opacity="0.94">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在软件内载入视频…" Foreground="#AFC3D4" FontSize="12.5" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
