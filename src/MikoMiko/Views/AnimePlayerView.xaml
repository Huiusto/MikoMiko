<UserControl x:Class="MikoMiko.Views.AnimePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             FontFamily="{DynamicResource Font.Ui}">
    <UserControl.Resources>
        <Style x:Key="PlayerEpisodeItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9FB4C6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#16222F" CornerRadius="8" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D3040" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F86B9" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSourceItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#C0D3E2" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#16222F" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D3040" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DFF2FE" />
                                <Setter Property="Foreground" Value="#1F6E9D" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#081019">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1621" BorderBrush="#1C2C3D" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource CaptionButton}" Width="30" Height="30" Click="Close_Click" ToolTip="返回追番页">
                    <Path Data="M9 0 L1 8 L9 16" Stroke="#D7E6F2" StrokeThickness="1.5"
                          Width="9" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="#F2F7FB"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" FontSize="10.5" Foreground="#7F99AD" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WebFallbackButton" Content="网页播放" Height="26" Padding="10,0"
                            Margin="0,0,8,0" FontSize="10" Cursor="Hand"
                            Background="#172637" Foreground="#B9CADA" BorderBrush="#29485E"
                            BorderThickness="1" Click="WebFallback_Click"
                            ToolTip="直连流播放异常时，打开站点原播放页" />
                    <ToggleButton x:Name="Anime4KToggle" Content="Anime4K 超分" Height="26" Padding="10,0"
                                  Margin="0,0,8,0" FontSize="10" Cursor="Hand"
                                  Background="#172637" Foreground="#8FD3F4" BorderBrush="#29485E"
                                  BorderThickness="1" Checked="Anime4K_Toggled" Unchecked="Anime4K_Toggled"
                                  ToolTip="开启实时 Anime4K 自适应边缘超分" />
                    <Border Background="#172637" CornerRadius="9" Padding="9,4" Margin="0,0,8,0">
                        <TextBlock x:Name="ModeText" FontSize="10" Foreground="#8FD3F4" />
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="30"
                            Click="Close_Click" ToolTip="{Binding [Common.Close], Source={x:Static loc:Loc.Instance}}">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="#F2F7FB"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="382" />
            </Grid.ColumnDefinitions>

            <!-- 左侧视频 -->
            <Grid Background="#000000" ClipToBounds="True">
                <wv2:WebView2 x:Name="Web" Loaded="Web_Loaded" />
                <Border x:Name="LoadingPanel" Background="#071019" Opacity="0.93">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True" Foreground="#4EA4DD"
                                     Background="#193044" BorderThickness="0" />
                        <TextBlock x:Name="LoadingText" Text="正在连接视频流…" Foreground="#AFC3D4"
                                   FontSize="12" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧详情 / 线路 / 选集 -->
            <Border Grid.Column="1" Background="#0D1621" BorderBrush="#1C2C3D" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,18,26">

                        <Border Height="142" CornerRadius="12" ClipToBounds="True" Background="#132131">
                            <Grid>
                                <TextBlock Text="MikoMiko" FontSize="15" Foreground="#4C6B84"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PosterImage" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DetailTitle" FontSize="21" FontWeight="Bold" Foreground="#F4FAFF"
                                   TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="28" />
                        <TextBlock x:Name="DetailMeta" FontSize="10.5" Foreground="#7F99AD"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />

                        <Border Background="#111D2A" BorderBrush="#1B2C3D" BorderThickness="1" CornerRadius="10"
                                Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="DescriptionText" FontSize="11.5" LineHeight="19"
                                       Foreground="#AFC3D3" TextWrapping="Wrap" MaxHeight="104"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FollowButton" Height="36" Background="#2F86B9" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="Follow_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="FollowIcon" Data="M3 1 H10 V14 L6.5 11 L3 14 Z"
                                          Stroke="White" StrokeThickness="1.2" Width="10" Height="13"
                                          Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FollowText" Text="追剧" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Background="#16222F" CornerRadius="18" Padding="14,0"
                                    VerticalAlignment="Center" Height="36">
                                <TextBlock x:Name="EpisodeInfoText" Text="选集" FontSize="10.5"
                                           Foreground="#7F99AD" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel x:Name="ProviderSection" Margin="0,18,0,0">
                            <Grid>
                                <TextBlock Text="查询网站" FontSize="11" FontWeight="SemiBold" Foreground="#7F99AD" />
                                <TextBlock Text="可换站重新查询" FontSize="9.5" Foreground="#4E6A81"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="ProviderList" Margin="0,9,0,0" Background="Transparent"
                                     BorderThickness="0" ItemContainerStyle="{StaticResource PlayerSourceItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="Providers_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <TextBlock Text="播放线路" FontSize="11" FontWeight="SemiBold" Foreground="#7F99AD"
                                   Margin="0,12,0,9" />
                        <ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlayerSourceItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="Sources_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,6,0,9">
                            <TextBlock Text="选集" FontSize="11" FontWeight="SemiBold" Foreground="#7F99AD" />
                            <TextBlock x:Name="EpisodeCountText" FontSize="10" Foreground="#5E7A90"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox x:Name="EpisodeList" MaxHeight="300" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlayerEpisodeItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="Episodes_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SwitchStatus" FontSize="10.5" Foreground="#E0A46A"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
