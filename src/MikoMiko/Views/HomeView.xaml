<UserControl x:Class="MikoMiko.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="FeedCard">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel Margin="0,0,0,2">
                    <Grid Height="190">
                        <Border CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                            <Image controls:AsyncImage.Url="{Binding Cover}" controls:AsyncImage.Fallback="Assets/Demo/cover01.jpg" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <Border Height="54" VerticalAlignment="Bottom" CornerRadius="0,0,9,9"
                                Background="{DynamicResource Brush.CoverMask}" IsHitTestVisible="False" />

                        <Grid VerticalAlignment="Bottom" Margin="9,0,9,8" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M0 0 L8 4.6 L0 9.2 Z" Fill="White" Width="8" Height="9"
                                      Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ViewText}" Foreground="White" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                                <Path Data="M0.6 0.6 H11.4 V7.6 H5.4 L2.6 10.2 V7.6 H0.6 Z" Stroke="White"
                                      StrokeThickness="1" Width="11" Height="10" Stretch="Uniform"
                                      Margin="11,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReplyText}" Foreground="White" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="15" LineHeight="21" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="1,10,0,0" />

                    <Grid Margin="1,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.TagOrangeBg}" CornerRadius="4"
                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TagText}" Foreground="{DynamicResource Brush.TagOrange}" FontSize="11.5" />
                        </Border>

                        <Border Grid.Column="1" Width="16" Height="16" CornerRadius="3"
                                Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock Text="UP" FontSize="8.5" Foreground="{DynamicResource Brush.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding MetaText}" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0" ScrollChanged="FeedScroll_ScrollChanged">
            <StackPanel Margin="26,18,18,30">

                <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.TagBlueBg}" CornerRadius="6"
                        Padding="10,6" Margin="0,0,0,16"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.TagBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Common.Offline], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource Brush.TagBlue}" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FeedCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGridPanel MinItemWidth="300" Gap="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding [Home.Empty], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,60,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <StackPanel HorizontalAlignment="Center" Margin="0,26,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,6"
                            Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Common.Loading], Source={x:Static loc:Loc.Instance}}"
                               Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,6">
                    <Button Style="{StaticResource SoftButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 1.5 A6.5 6.5 0 1 0 14.6 6.5 M14.6 6.5 V2.6 M14.6 6.5 H10.7"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

