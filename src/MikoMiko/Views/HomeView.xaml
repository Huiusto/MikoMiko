<UserControl x:Class="MikoMiko.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <Style x:Key="FilterCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Data="M0 0 L5 5 L10 0" Width="10" Height="5" Stretch="Uniform"
                                          Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.4"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ToggleButton Focusable="False" ClickMode="Press"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="4" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FeedCard">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                    CommandParameter="{Binding}">
                <StackPanel Margin="0,0,0,2">
                    <Grid Height="190">
                        <Border CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                            <Grid>
                                <Image Source="pack://application:,,,/Assets/Demo/placeholder.png" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image controls:AsyncImage.Url="{Binding CardCover}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <Border Height="54" VerticalAlignment="Bottom" CornerRadius="0,0,9,9"
                                Background="{DynamicResource Brush.CoverMask}" IsHitTestVisible="False" />

                        <Grid VerticalAlignment="Bottom" Margin="9,0,9,8" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M0 0 L8 4.6 L0 9.2 Z" Fill="White" Width="8" Height="9"
                                      Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ViewText}" Foreground="White" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                                <Path Data="M0.6 0.6 H11.4 V7.6 H5.4 L2.6 10.2 V7.6 H0.6 Z" Stroke="White"
                                      StrokeThickness="1" Width="11" Height="10" Stretch="Uniform"
                                      Margin="11,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReplyText}" Foreground="White" FontSize="11.5"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="15" LineHeight="21" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="1,10,0,0" />

                    <Grid Margin="1,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.TagOrangeBg}" CornerRadius="4"
                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TagText}" Foreground="{DynamicResource Brush.TagOrange}" FontSize="11.5" />
                        </Border>

                        <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="4"
                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}"
                                       FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="2" Background="{Binding MikoBadgeBackground}" CornerRadius="4"
                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowMikoBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MikoBadgeText}" Foreground="{Binding MikoBadgeForeground}"
                                       FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="3" Background="#FF6FA5" CornerRadius="4"
                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowCertBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="V" Foreground="White" FontSize="9.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="4" Text="{Binding MetaText}" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0" ScrollChanged="FeedScroll_ScrollChanged">
            <StackPanel Margin="26,18,18,30">

                <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.TagBlueBg}" CornerRadius="6"
                        Padding="10,6" Margin="0,0,0,16"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.TagBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Common.Offline], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource Brush.TagBlue}" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 帖子：分区 / 版块 / 排序（对应参考图三连下拉） -->
                <Grid Margin="0,0,0,18" Visibility="{Binding IsPostsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="M2 2 H13 V13 H2 Z M2 6 H13 M6 2 V13" Stroke="{DynamicResource Brush.TextTertiary}"
                              StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="190"
                                  ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
                                  />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Path Data="M1 1 H6 V6 H1 Z M9 1 H14 V6 H9 Z M1 9 H6 V14 H1 Z M9 9 H14 V14 H9 Z"
                              Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.1"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="156"
                                  ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
                                  />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Path Data="M1 3 H14 M1 7 H10 M1 11 H13" Stroke="{DynamicResource Brush.TextTertiary}"
                              StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <ComboBox Style="{StaticResource FilterCombo}" Width="136"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
                                  />
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" Margin="14,0,0,0" />
                </Grid>

                <!-- 0.1.10：去掉搜索结果分类页签，搜索直接展示用户与综合内容。 -->

                <!-- 搜索优先展示用户，再展示内容 -->
                <StackPanel Margin="0,0,0,16" Visibility="{Binding ShowSearchUsers, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="相关用户" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"
                               Visibility="{Binding HasSearchUsers, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding SearchUsers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Width="248" Margin="0,0,12,12" Padding="12,10"
                                        Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True"
                                                Background="{DynamicResource Brush.Card}" VerticalAlignment="Top">
                                            <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Nickname}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Certification}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Certification, Converter={StaticResource NotEmptyToVis}}" />
                                            <TextBlock Text="{Binding Introduce}" FontSize="11" LineHeight="16"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,3,0,0"
                                                       MaxHeight="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FansText, StringFormat=粉丝 {0}}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FeedCard}"
                              Visibility="{Binding ShowFeedGrid, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGridPanel MinItemWidth="300" Gap="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding [Home.Empty], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,60,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <StackPanel HorizontalAlignment="Center" Margin="0,26,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,6"
                            Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Common.Loading], Source={x:Static loc:Loc.Instance}}"
                               Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,6">
                    <Button Style="{StaticResource SoftButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 1.5 A6.5 6.5 0 1 0 14.6 6.5 M14.6 6.5 V2.6 M14.6 6.5 H10.7"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 内容右下角：刷新 / 返回顶部 -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22">
            <Button Width="42" Height="42" Cursor="Hand" Click="FloatingRefresh_Click" ToolTip="刷新">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="21" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M8 1.5 A6.5 6.5 0 1 0 14.6 6.5 M14.6 6.5 V2.6 M14.6 6.5 H10.7"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="42" Height="42" Margin="0,8,0,0" Cursor="Hand" Click="BackToTop_Click" ToolTip="返回顶部">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="21" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M12 3 L12 21 M5 10 L12 3 L19 10" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>


