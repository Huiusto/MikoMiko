<UserControl x:Class="MikoMiko.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <conv:StringEqualsToVisibilityConverter x:Key="IsSection" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingsNavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Grid.Column="0" Width="3" Height="14" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="186" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="ScrollHost" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel Margin="26,18,24,30">

                <StackPanel Margin="2,0,0,14">
                    <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="管理外观、播放、下载与账号；修改后会立即保存。" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 账号头部 -->
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="20,16"
                        HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True"
                                Background="{DynamicResource Brush.Card}">
                            <Image controls:AsyncImage.Url="{Binding AccountAvatar}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AccountUid}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding AccountActionText}"
                                    Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                    Command="{Binding AccountActionCommand}" />
                            <Button Content="{Binding [Mine.Logout], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 0.1.9：项目主页在系统浏览器打开，开发者首页留在软件内打开 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="访问项目主页（GitHub）" Style="{StaticResource SoftButton}" Height="34"
                            Padding="16,0" Command="{Binding OpenProjectPageCommand}" />
                    <Button Content="开发者首页（支持、讨论、问题反馈）" Style="{StaticResource GhostButton}"
                            Height="34" Padding="16,0" Margin="10,0,0,0"
                            Command="{Binding OpenDeveloperHomeCommand}" />
                </StackPanel>

                <Grid x:Name="SectionsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!-- 常规设置 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,14,0,14" Tag="General">
                    <StackPanel>
                        <TextBlock Text="{Binding [S.General], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [S.ColorMode], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding [S.ColorModeHint], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource RowHint}" Margin="4,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ThemeOptions}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource ChipButton}"
                                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                            <TextBlock Text="{Binding [S.Font], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding [S.FontHint], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource RowHint}" Margin="4,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FontOptions}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource ChipButton}"
                                            Command="{Binding DataContext.SelectFontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding [S.Startup], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource RowLabel}" Margin="0,14,0,10" />
                        <CheckBox Content="{Binding [S.AutoStart], Source={x:Static loc:Loc.Instance}}"
                                  Style="{StaticResource MikoCheckBox}" IsChecked="{Binding Settings.AutoStart}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <RadioButton Content="{Binding [S.StartLaunch], Source={x:Static loc:Loc.Instance}}"
                                         GroupName="StartPage" IsChecked="{Binding Settings.StartOnLaunch}" Margin="0,0,20,0" />
                            <RadioButton Content="{Binding [S.StartHome], Source={x:Static loc:Loc.Instance}}"
                                         GroupName="StartPage" IsChecked="{Binding Settings.StartOnHome}" Margin="0,0,24,0" />
                            <RadioButton Content="启动时默认进入视频" GroupName="StartPage"
                                         IsChecked="{Binding Settings.StartOnVideo}" />
                        </StackPanel>
                        <CheckBox Content="视频结束自动下滑"
                                  Style="{StaticResource MikoCheckBox}" IsChecked="{Binding Settings.AutoNextVideo}" />
                        <CheckBox Content="下滑视频自动播放"
                                  Style="{StaticResource MikoCheckBox}" IsChecked="{Binding Settings.AutoPlayOnSwipe}" />
                        <CheckBox Content="{Binding [S.RememberPage], Source={x:Static loc:Loc.Instance}}"
                                  Style="{StaticResource MikoCheckBox}" IsChecked="{Binding Settings.RememberLastPage}" />

                        <TextBlock Text="{Binding [S.CloseAction], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource RowLabel}" Margin="0,14,0,10" />
                        <ItemsControl ItemsSource="{Binding CloseOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource ChipButton}"
                                            Command="{Binding DataContext.SelectCloseActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 缓存管理 -->
                <Border Grid.Row="1" Grid.Column="0" MinHeight="180"
                        Style="{StaticResource SectionCard}" Margin="0,0,0,14" Tag="Cache">
                    <StackPanel>
                        <TextBlock Text="{Binding [S.Cache], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [S.CacheSize], Source={x:Static loc:Loc.Instance}}"
                                               Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{Binding CacheSize}" FontSize="13.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Button Content="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                            Command="{Binding RefreshCacheSizeCommand}" />
                                </StackPanel>

                                <Button Content="{Binding [S.CacheClear], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Command="{Binding ClearCacheCommand}" />
                                <TextBlock Text="运行期间每1小时自动清理一次过期缓存文件。" Style="{StaticResource RowHint}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="下载位置" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding DownloadDirectory}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="更改下载位置" Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                            Command="{Binding ChangeDownloadDirectoryCommand}" />
                                    <Button Content="打开下载位置" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                            Command="{Binding OpenDownloadDirectoryCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 应用维护：合并原「通用设置」与「应用维护」 -->
                <Border Grid.Row="2" Grid.Column="0" MinHeight="180"
                        Style="{StaticResource SectionCard}" Margin="0,0,0,14" Tag="Maintain">
                    <StackPanel>
                        <TextBlock Text="{Binding [S.Maintain], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="{Binding [S.CheckUpdateStart], Source={x:Static loc:Loc.Instance}}"
                                  Style="{StaticResource MikoCheckBox}" IsChecked="{Binding Settings.CheckUpdateOnStartup}"
                                  Margin="0,2,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [S.CheckUpdate], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource AccentButton}" Height="34" Padding="16,0"
                                    Command="{Binding CheckUpdateCommand}" />
                            <Button Content="{Binding [S.Uninstall], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource GhostButton}" Height="34" Padding="16,0" Margin="10,0,0,0"
                                    Command="{Binding UninstallCommand}" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource RowHint}" Margin="14,0,0,0"
                                       Visibility="{Binding UpdateStatus, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding [S.MaintainHint], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource RowHint}" Margin="0,12,0,0" TextWrapping="Wrap" />

                        <Button Content="{Binding [S.Changelog], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource SoftButton}" Height="32" Padding="14,0"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding ToggleChangelogCommand}" />

                        <TextBlock Text="{Binding [S.AppDesc], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- 应用信息：关于在上，版本与数据目录在下 -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SectionCard}"
                        Margin="0,0,0,14" Tag="AppInfo">
                    <StackPanel>
                        <TextBlock Text="应用信息"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="关于 MikoMiko、运行环境与数据目录。"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icon.png" Width="64" Height="64" />
                            <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MikoMiko" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [About.Slogan], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding [About.Desc], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Stretch" />

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,20,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="名称" Style="{StaticResource RowHint}" Margin="0,0,0,11" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="MikoMiko（米游社 PC 多功能桌面客户端）"
                                       FontSize="12.5" Margin="0,0,0,11" />

                            <TextBlock Grid.Row="1" Text="版本" Style="{StaticResource RowHint}" Margin="0,0,0,11" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionText}" FontSize="12.5" Margin="0,0,0,11" />

                            <TextBlock Grid.Row="2" Text="框架" Style="{StaticResource RowHint}" Margin="0,0,0,11" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeText}" FontSize="12.5" Margin="0,0,0,11" />

                            <TextBlock Grid.Row="3" Text="数据目录" Style="{StaticResource RowHint}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AppDataDirectory}" FontSize="12.5"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="应用的所有数据（设置、账号登录态、视频缓存、图片缓存等）都保存在此文件夹。更改数据目录后需重启 MikoMiko 生效，原有数据不会自动迁移。"
                                   FontSize="11.8" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" HorizontalAlignment="Stretch" Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                    Command="{Binding OpenDataDirectoryCommand}" />
                            <Button Content="更改数据目录" Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                    Margin="10,0,0,0" Command="{Binding ChangeDataDirectoryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- 免责说明 -->
                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource SectionCard}"
                        Margin="0,0,0,14" Tag="Disclaimer">
                    <StackPanel>
                        <TextBlock Text="{Binding [S.Disclaimer], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding [Disclaimer.Desc], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" LineHeight="20" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- 开源说明 -->
                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource SectionCard}"
                        Margin="0,0,0,14" Tag="OpenSource">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding [S.OpenSource], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1A4EA4DD"
                                    BorderBrush="#4D4EA4DD" BorderThickness="1" CornerRadius="9" Padding="9,3">
                                <TextBlock Text="MIT License" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12.5"
                                   HorizontalAlignment="Stretch" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="MikoMiko 是一个完全开源的米游社第三方桌面客户端，基于 .NET 8 与 WPF 构建。所有源码均公开在 GitHub，欢迎阅读、学习、提交问题与参与改进。" />

                        <Border Background="{DynamicResource Brush.ControlBg}" CornerRadius="9" Padding="14,12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock FontSize="12" LineHeight="21" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="• 许可证：MIT License，可自由使用、修改与分发，保留版权与许可声明即可。" />
                                <TextBlock FontSize="12" LineHeight="21" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="• 技术栈：.NET 8 / WPF / WebView2，界面与业务逻辑全部开放，欢迎二次开发。" />
                                <TextBlock FontSize="12" LineHeight="21" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="• 复用说明：转载或基于本项目发布衍生版本时，请注明原仓库地址，并保留原有版权声明。" />
                                <TextBlock FontSize="12" LineHeight="21" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="• 非官方声明：本项目由个人开发者维护，与米哈游及米游社官方无任何关联。" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                            <Button Content="访问 GitHub 仓库" Style="{StaticResource SoftButton}" Height="32"
                                    Padding="15,0" Command="{Binding OpenProjectPageCommand}" />
                            <TextBlock Text="github.com/Huiusto/MikoMiko" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 更新日志入口已放入「应用维护」，点击打开右侧抽屉弹窗 -->

            </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧目录：点击跳到对应设置位置 -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                Background="{DynamicResource Brush.NavBg}" Padding="12,22,12,16">
            <StackPanel>
                <TextBlock Text="设置目录" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="6,0,0,12" />
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SettingsNavButton}" Content="{Binding Label}"
                                    Tag="{Binding Key}" Click="Section_Click" Margin="0,1,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- 更新日志抽屉：点击任何弹窗外位置关闭 -->
        <Grid x:Name="ChangelogOverlay" Grid.ColumnSpan="2" Background="#66000000"
              Visibility="{Binding IsChangelogOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="ChangelogOverlay_Click">
            <Border Width="430" HorizontalAlignment="Right" Background="{DynamicResource Brush.WindowBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding [S.Changelog], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="关闭"
                                Command="{Binding ToggleChangelogCommand}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ChangelogText}" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" LineHeight="23" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
