<Window x:Class="MikoMiko.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="米游社扫码登录" Width="520" Height="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}">

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <TextBlock Text="米游社扫码登录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="30"
                            HorizontalAlignment="Right" Click="Close_Click">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextPrimary}"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" />
                <Border x:Name="LoadingMask" Background="{DynamicResource Brush.WindowBg}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="正在打开米游社登录页…" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="用米游社 App 扫描页面上的二维码即可登录" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" Padding="16,10"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="登录成功后会自动读取账号信息，无需手动粘贴 Cookie"
                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
