<UserControl x:Class="MikoMiko.Views.DailyTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryTaskButton" TargetType="Button" BasedOn="{StaticResource TaskButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
        </Style>

        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Foreground" Value="#B8790E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="OK">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,18,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="27" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="每日任务" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </StackPanel>
                <TextBlock Text="米游社每日任务 · 角色签到 · 多账号一键执行" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="14,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="11" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock x:Name="TxtAvatar" Text="灰" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAccount" Text="读取账号中…" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Brush.Success}"
                                         VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtAccountState" Text="已登录" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnRefresh" Content="刷新" Style="{StaticResource TaskButton}" Click="BtnRefresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 米游社任务 -->
                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="16" Padding="18,16,18,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="米游社任务" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <Border x:Name="MissionBadge" Background="{DynamicResource Brush.AccentSoft}"
                                            CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtMissionBadge" Text="0/50 米游币" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtPoints" Grid.Column="1" Text="—" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="持有米游币" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,3,0,0" HorizontalAlignment="Right" />

                            <Border Height="1" Background="{DynamicResource Brush.BorderSoft}" Margin="0,12,0,10" />
                            <StackPanel x:Name="MissionPanel" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtMissionHint" Text="" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="BtnMissionReload" Grid.Column="1" Content="刷新任务"
                                        Style="{StaticResource TaskButton}" Click="BtnMissionReload_Click" Margin="8,0,0,0" />
                                <Button x:Name="BtnMissionRun" Grid.Column="2" Content="一键执行"
                                        Style="{StaticResource PrimaryTaskButton}" Click="BtnMissionRun_Click" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 角色签到 -->
                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="16" Padding="18,16,18,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="签到任务" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="8,3"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRoleBadge" Text="0 个角色" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="BtnSignAll" Content="一键签到" Style="{StaticResource TaskButton}"
                                        HorizontalAlignment="Right" Click="BtnSignAll_Click" />
                            </Grid>
                            <TextBlock Text="按账号绑定的游戏角色逐一签到，已签到的角色会自动跳过。"
                                       FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,10" />
                            <Border Height="1" Background="{DynamicResource Brush.BorderSoft}" Margin="0,0,0,8" />
                            <StackPanel x:Name="RolePanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 输出日志 -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="16" Padding="16,14,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="输出日志" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="7" Padding="7,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLogCount" Text="0" FontSize="10"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnClearLog" Content="清空" Style="{StaticResource TaskButton}"
                                HorizontalAlignment="Right" Padding="12,5" Click="BtnClearLog_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Margin="0,10,0,0">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource LogText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
