<UserControl x:Class="MikoMiko.Views.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <DataTemplate x:Key="PostCardTemplate">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenPostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="170" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                        <Image controls:AsyncImage.Url="{Binding CardCover}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                               MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="1,9,0,0" />
                    <TextBlock Text="{Binding MetaText}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="1,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="ProfileTabButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel>
                            <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="13.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,5" />
                            <Border x:Name="Line" Height="2" Width="28" CornerRadius="1" Background="Transparent" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,18,0">
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Command="{Binding CloseCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9 1 L2 7 L9 13" Stroke="{DynamicResource Brush.TextSecondary}"
                              StrokeThickness="1.5" Width="9" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="返回" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="用户主页" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,22,26,34">
                <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource Brush.Card}">
                    <Grid Height="140">
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4EA4DD" Offset="0" />
                                    <GradientStop Color="#FF8FC9E8" Offset="0.55" />
                                    <GradientStop Color="#FFF4E8D8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="120">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#99000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="18,12,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="82" Height="82" CornerRadius="41" BorderThickness="4" BorderBrush="White"
                            ClipToBounds="True" Background="{DynamicResource Brush.Card}">
                        <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding IdentityBadgeBackground}" CornerRadius="4" Padding="6,2"
                                    Margin="0,0,7,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowIdentityBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding IdentityBadgeText}" Foreground="{Binding IdentityBadgeForeground}"
                                           FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Nickname}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <Border Background="#EAF6FD" CornerRadius="4" Padding="5,1" Margin="7,2,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding LevelText, Converter={StaticResource NotEmptyToVis}}">
                                <TextBlock Text="{Binding LevelText}" FontSize="10.5" Foreground="#2B8CC4" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding UserUidText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Visibility="{Binding UserUidText, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="7,0"
                                       Visibility="{Binding IpRegion, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="{Binding IpRegion}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding FollowText}" Style="{StaticResource AccentButton}"
                            Height="34" Padding="18,0" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding ToggleFollowCommand}" />
                </Grid>

                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="18,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Introduce}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding HasIntroduce, Converter={StaticResource BoolToVis}}" />

                        <!-- 认证标签 + 用户全部可用标签 -->
                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="7,2"
                                    Margin="0,0,7,6"
                                    Visibility="{Binding HasCertification, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Certification}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="4" Padding="7,2"
                                                Margin="0,0,7,6">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PostText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="发布" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FansText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="粉丝" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding FollowingText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="关注" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding LikeText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="获赞" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 该用户的游戏角色 -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="TA 的游戏角色" FontSize="14.5" FontWeight="SemiBold" Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="9" ClipToBounds="True"
                                                Background="{DynamicResource Brush.Card}">
                                            <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RoleName}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <Run Text="{Binding LevelLabel}" />
                                                <Run Text="{Binding Level}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Server}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <Run Text="UID" />
                                                <Run Text="{Binding Uid}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 四个内容页签 + 该用户发布内容搜索 -->
                <Grid Margin="2,22,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ProfileTabButton}" Margin="0,0,26,0"
                                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Column="1" Width="238" Height="32" CornerRadius="16"
                            Background="{DynamicResource Brush.Surface}" Padding="11,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M7.5 1.5 A6 6 0 1 0 7.5 13.5 A6 6 0 1 0 7.5 1.5 M11.8 11.8 L15 15"
                                  Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.2"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="12"
                                     Foreground="{DynamicResource Brush.TextPrimary}" VerticalContentAlignment="Center"
                                     Margin="7,0,0,0" />
                            <Button Grid.Column="2" Content="搜索" Style="{StaticResource LinkButton}"
                                    FontSize="11.5" Padding="4,0" Command="{Binding SearchPostsCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- TA 的发布 -->
                <StackPanel Visibility="{Binding IsPostsTab, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Posts}" ItemTemplate="{StaticResource PostCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="290" Gap="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="TA 还没有发布内容" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,34,0,0"
                               Visibility="{Binding HasPosts, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- TA 的评论 -->
                <StackPanel Visibility="{Binding IsRepliesTab, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Replies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Padding="16,12"
                                        Margin="0,0,0,10" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PostTitle}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Content}" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"
                                                   MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                                            <TextBlock Text="{Binding LikeText, StringFormat=· {0} 赞}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="TA 还没有评论" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,34,0,0"
                               Visibility="{Binding HasReplies, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- TA 的合集 -->
                <StackPanel Visibility="{Binding IsCollectionsTab, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="290" Gap="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                                        Padding="10" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border Height="160" CornerRadius="8" ClipToBounds="True"
                                                Background="{DynamicResource Brush.Card}">
                                            <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="2,9,2,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,5,2,2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="TA 还没有公开合集" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,34,0,0"
                               Visibility="{Binding HasCollections, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- TA 的收藏 -->
                <StackPanel Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource PostCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="290" Gap="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="TA 还没有公开收藏" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,34,0,0"
                               Visibility="{Binding HasFavorites, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 0.1.11：点击「TA 的游戏角色」打开对应游戏的战绩详情 -->
        <Grid Grid.RowSpan="2" Background="#CC000000"
              Visibility="{Binding IsGameDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="600" MaxHeight="560" Background="{DynamicResource Brush.WindowBg}" CornerRadius="14"
                    Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="44" CornerRadius="3" Background="{Binding SelectedGame.Accent}" />
                            <StackPanel Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedGame.GameName}" FontSize="19" FontWeight="SemiBold" />
                                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="4" Padding="6,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Badge}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding SelectedGame.RoleName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedGame.Uid, StringFormat='UID {0}'}" FontSize="11.5"
                                               Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextTertiary}" />
                                    <TextBlock Text="{Binding SelectedGame.Server}" FontSize="11.5" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                                Cursor="Hand" Command="{Binding CloseGameDetailCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" CornerRadius="16" Background="{DynamicResource Brush.Card}">
                                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextSecondary}"
                                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
                            Padding="14,12" Margin="0,16,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="战绩详情" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="数据来自米游社公开角色卡" FontSize="10.5" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedGame.Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="8" Padding="10,9"
                                                Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                                <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="该角色没有公开战绩数据" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,6,0,2"
                                       Visibility="{Binding SelectedGame.HasStats, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
