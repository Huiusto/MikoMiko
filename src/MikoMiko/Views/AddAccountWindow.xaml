<Window x:Class="MikoMiko.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加米游社账号"
        Width="540" Height="690"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" ShowInTaskbar="False">
    <Border Background="#FFFFFF" CornerRadius="18" BorderBrush="#DCE7F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#22364A" BlurRadius="36" ShadowDepth="10" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#E7F5FE">
                        <TextBlock Text="＋" FontSize="19" FontWeight="Bold" Foreground="#2C8CC9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="添加米游社账号" FontSize="20" FontWeight="Bold" Foreground="#172330" />
                        <TextBlock Text="扫码、粘贴 Cookie，或直接导入 MikoNest 账号" FontSize="11"
                                   Foreground="#7B8C9D" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BtnClose" Content="✕" Width="34" Height="34" FontSize="16"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                        Background="Transparent" Foreground="#8393A2" BorderThickness="0" Cursor="Hand"
                        Click="BtnClose_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnTabQr" Grid.Column="0" Content="扫码登录" Height="36" Margin="0,0,6,0"
                        Click="BtnTabQr_Click" Cursor="Hand" BorderThickness="0" Background="#E9F6FE"
                        Foreground="#2587C8" FontWeight="SemiBold" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnTabCookie" Grid.Column="1" Content="Cookie 登录" Height="36" Margin="6,0,6,0"
                        Click="BtnTabCookie_Click" Cursor="Hand" BorderThickness="0" Background="#F3F7FA"
                        Foreground="#687B8D" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnTabImport" Grid.Column="2" Content="从 MikoNest 导入" Height="36" Margin="6,0,0,0"
                        Click="BtnTabImport_Click" Cursor="Hand" BorderThickness="0" Background="#F3F7FA"
                        Foreground="#687B8D" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <!-- 扫码 -->
                <StackPanel x:Name="PanelQr">
                    <Border Width="246" Height="246" CornerRadius="14" Background="#F7FBFE"
                            BorderBrush="#D9EAF6" BorderThickness="1" HorizontalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="TxtQrPlaceholder" Text="点击下方按钮生成二维码" FontSize="12"
                                       Foreground="#94A6B6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ImgQr" Width="220" Height="220" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtQrStatus" Text="使用「米游社」App 扫码，并在手机上确认登录"
                               FontSize="12" Foreground="#667A8C" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="18,16,18,0" MinHeight="38" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="BtnQrStart" Content="生成二维码" Width="144" Height="40"
                                Background="#2F9DE0" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                FontWeight="SemiBold" FontSize="13" Click="BtnQrStart_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9" /></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnQrCancel" Content="取消" Width="82" Height="40" Margin="10,0,0,0"
                                Background="#F2F6FA" Foreground="#708496" BorderThickness="0" Cursor="Hand" FontSize="13"
                                Click="BtnQrCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E9F1F7" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="扫码登录只用于读取账号身份与每日任务，Cookie 会使用 Windows DPAPI 加密保存在本机。"
                               FontSize="10.5" Foreground="#9AABBA" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="26,14,26,0" />
                </StackPanel>

                <!-- Cookie -->
                <StackPanel x:Name="PanelCookie" Visibility="Collapsed">
                    <TextBlock Text="粘贴米游社完整 Cookie" FontSize="13" FontWeight="SemiBold" Foreground="#243544" />
                    <TextBlock Text="必须包含 stoken。可从米游社 App 的登录抓包中复制，或使用上面的扫码登录。"
                               FontSize="10.5" Foreground="#899BAB" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <Border Background="#F7FAFC" BorderBrush="#DCE8F2" BorderThickness="1" CornerRadius="10" Height="210">
                        <TextBox x:Name="TxtCookie" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Padding="12,10" FontFamily="Consolas" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <TextBlock x:Name="TxtCookieStatus" Text="" FontSize="11.5" Foreground="#718496"
                               TextWrapping="Wrap" Margin="2,10,2,0" MinHeight="34" />
                    <Button x:Name="BtnCookieAdd" Content="验证并添加账号" Width="180" Height="42"
                            HorizontalAlignment="Right" Background="#2F9DE0" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13"
                            Click="BtnCookieAdd_Click" Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 导入 -->
                <StackPanel x:Name="PanelImport" Visibility="Collapsed">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#E9F6FE" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="⇩" FontSize="34" FontWeight="Bold" Foreground="#2F9DE0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="导入 MikoNest 中的米游社账号" FontSize="16" FontWeight="Bold"
                               Foreground="#213342" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="会把 MikoNest 已登录的账号合并到 MikoMiko。相同 UID 不会重复添加，Cookie 会重新加密保存。"
                               FontSize="11.5" Foreground="#7C8FA0" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="360" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtImportStatus" Text="" FontSize="11.5" Foreground="#718496"
                               TextAlignment="Center" Margin="0,12,0,0" MinHeight="28" />
                    <Button x:Name="BtnImport" Content="开始导入" Width="160" Height="42" Margin="0,10,0,0"
                            HorizontalAlignment="Center" Background="#2F9DE0" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13"
                            Click="BtnImport_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="账号凭据仅保存在当前 Windows 用户目录，不会上传到网络。"
                       FontSize="10.5" Foreground="#9AABBA" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
