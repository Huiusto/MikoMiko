<UserControl x:Class="MikoMiko.Views.MomentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <Style x:Key="FilterChipAll" TargetType="{x:Type Button}" BasedOn="{StaticResource ChipButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAll}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterChipFollow" TargetType="{x:Type Button}" BasedOn="{StaticResource ChipButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnlyFollowing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：关注用户导航（参考米游社关注页） -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,16,10,22">
                    <TextBlock Text="我的关注" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,10" />

                    <Button Command="{Binding SelectAllCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Bd" CornerRadius="9" Padding="9,8" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="#F5A9C2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M6 0 L7.5 4.5 L12 6 L7.5 7.5 L6 12 L4.5 7.5 L0 6 L4.5 4.5 Z"
                                      Fill="White" Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="全部动态" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="8,9,8,9" />

                    <ItemsControl ItemsSource="{Binding FollowingUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectAuthorCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,0,2">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" CornerRadius="9" Padding="8,7" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F8FB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="#E8556D" VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                        <Grid Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Left">
                                            <Ellipse Fill="#E4F0FA" />
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Text="{Binding PostCountText}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="MomentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Margin="26,18,18,30" MaxWidth="1160" HorizontalAlignment="Stretch">

                <!-- 头部 -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                    <TextBlock Text="{Binding [Moment.Title], Source={x:Static loc:Loc.Instance}}"
                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="10,4"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedAuthorName}" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                            Command="{Binding RefreshCommand}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                </StackPanel>

                <!-- 未登录引导 -->
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="40,46"
                        MaxWidth="640" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding NeedsLogin, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="{Binding [Moment.LoginRequired], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [Moment.LoginHint], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Moments}" Visibility="{Binding NeedsLogin, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="18,16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" ClipToBounds="True"
                                            Background="{DynamicResource Brush.Card}" VerticalAlignment="Top">
                                        <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Author}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="5,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="官方" FontSize="10" Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding TimeText}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Text}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"
                                                   Margin="0,8,0,0" MaxHeight="90" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding Topic}" FontSize="12.5" Foreground="{DynamicResource Brush.TagBlue}"
                                                   Margin="0,8,0,0" Visibility="{Binding HasTopic, Converter={StaticResource BoolToVis}}" />

                                        <!-- 单图 -->
                                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,10,0,0" MaxWidth="420"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasSingleImage, Converter={StaticResource BoolToVis}}">
                                            <Grid Height="216">
                                                <Image controls:AsyncImage.Url="{Binding Images[0]}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- 多图 -->
                                        <ItemsControl ItemsSource="{Binding Images}" Margin="0,10,0,0"
                                                      Visibility="{Binding HasMultiImage, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7" ClipToBounds="True" Width="250" Height="150" Margin="0,0,6,6">
                                                        <Image controls:AsyncImage.Url="{Binding}" Stretch="UniformToFill" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 视频动态 -->
                                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,10,0,0" MaxWidth="420"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                                            <Grid Height="216">
                                                <Image controls:AsyncImage.Url="{Binding VideoCover}" Stretch="UniformToFill" />
                                                <Border Height="40" VerticalAlignment="Bottom" Background="{DynamicResource Brush.CoverMask}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,9,8">
                                                    <Path Data="M0 0 L8 4.6 L0 9.2 Z" Fill="White" Width="8" Height="9" Stretch="Uniform" />
                                                    <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11.5" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource LinkButton}" Padding="0" Margin="0,0,22,0"
                                                    Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M0 0 L3.4 7 L9 8 L4.9 12 L6 17.6 L0.6 14.6"
                                                          Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.3"
                                                          Width="13" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding LikeText}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="5,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LinkButton}" Padding="0" Margin="0,0,22,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="收藏这条动态">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="☆" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorited}" Value="True">
                                                                        <Setter Property="Text" Value="★" />
                                                                        <Setter Property="Foreground" Value="#E8B33A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="收藏" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M0 9 L5 4 L10 9 M2.5 9 V1 H7.5 V9" Stroke="{DynamicResource Brush.TextTertiary}"
                                                      StrokeThickness="1.2" Width="11" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [Video.Share], Source={x:Static loc:Loc.Instance}}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding [Moment.Empty], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,50,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding [Common.Loading], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,50,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 内容右下角：刷新 / 返回顶部 -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22">
            <Button Width="42" Height="42" Cursor="Hand" Click="FloatingRefresh_Click" ToolTip="刷新">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="21" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M8 1.5 A6.5 6.5 0 1 0 14.6 6.5 M14.6 6.5 V2.6 M14.6 6.5 H10.7"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="42" Height="42" Margin="0,8,0,0" Cursor="Hand" Click="BackToTop_Click" ToolTip="返回顶部">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="21" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M12 3 L12 21 M5 10 L12 3 L19 10" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>



