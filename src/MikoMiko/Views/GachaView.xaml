<UserControl x:Class="MikoMiko.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True"
             Background="{DynamicResource Brush.WindowBg}">
    <UserControl.Resources>
        <Style x:Key="GachaCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource GachaComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Grid Margin="11,0,30,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="9.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <Path Data="M0 0 L4 4 L8 0" Width="8" Height="5" Stretch="Fill"
                                  Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   Placement="Bottom" VerticalOffset="5" StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="150"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="10" Padding="4">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GachaComboItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GachaButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GachaPrimaryButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GachaIconButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="GachaSideItem" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="GachaToggle" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="Margin" Value="1,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题在左，游戏 / UID / 设置 / 数据工具全部收进同一排右侧 -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.NavBg}" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="22,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="20" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="TxtHeaderTitle" Text="祈愿记录" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <Button x:Name="BtnBeyond" Height="24" Margin="10,0,0,0" Padding="10,0"
                            Background="{DynamicResource Brush.ControlBg}"
                            BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1"
                            Foreground="{DynamicResource Brush.Accent}" FontSize="10.5" Cursor="Hand"
                            Click="BtnBeyond_Click" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.86" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="千星奇域颂愿" FontSize="10.5" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="本地库 0 条 · MikoNest 数据" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="12,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="1" CornerRadius="12" Padding="10,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="ImgGameIcon" Width="20" Height="20" Margin="2,0,7,0"
                           VerticalAlignment="Center" Stretch="UniformToFill" />
                    <ComboBox x:Name="ComboGame" Tag="游戏" Width="132" Margin="0,0,8,0"
                              Style="{StaticResource GachaCombo}" SelectionChanged="ComboGame_SelectionChanged" />
                    <ComboBox x:Name="ComboUid" Tag="UID" Width="158" Margin="0,0,8,0"
                              Style="{StaticResource GachaCombo}" SelectionChanged="ComboUid_SelectionChanged" />
                    <Button x:Name="BtnUpdate" Content="更新记录" Width="80" Margin="0,0,8,0"
                            Style="{StaticResource GachaPrimaryButton}" Click="BtnUpdate_Click" />
                    <Button x:Name="BtnSettings" Content="记录设置" Width="78" Margin="0,0,8,0"
                            Style="{StaticResource GachaButton}" Click="BtnSettings_Click" />
                    <Button Content="导出 CSV" Style="{StaticResource GachaSideItem}" Click="ExportCsv_Click" />
                    <Button Content="记录目录" Style="{StaticResource GachaSideItem}" Click="OpenDataDir_Click" />
                    <Border Width="1" Height="36" Background="{DynamicResource Brush.BorderSoft}"
                            Margin="2,0,9,0" VerticalAlignment="Center" />
                    <Button x:Name="BtnOverview" Content="记录概览 ▸" Style="{StaticResource GachaToggle}"
                            Click="BtnOverview_Click" />
                    <Button x:Name="BtnAnalysis" Content="出货分析 ▸" Style="{StaticResource GachaToggle}"
                            Margin="7,0,0,0" Click="BtnAnalysis_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 展开后的概览 / 分析：浮在记录区上方，不再把下方记录整体挤下去 -->
        <Grid Grid.Row="1" Margin="18,56,18,0" Panel.ZIndex="30"
              HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="OverviewCard" Width="404" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderSoft}"
                        BorderThickness="1" CornerRadius="12" Padding="16,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="记录概览" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock x:Name="TxtSummarySub" Text="选择 UID 后开始统计" FontSize="9.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                        </Grid>
                        <StackPanel x:Name="SummaryPanel" Margin="0,8,0,0" />
                        <TextBlock Text="结尾百分比为对应稀有度出货率；金色为最高稀有度，紫色为次高档。"
                                   FontSize="9.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="AnalysisCard" Width="404" Visibility="Collapsed" Margin="10,0,0,0"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderSoft}"
                        BorderThickness="1" CornerRadius="12" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="出货分析" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <StackPanel x:Name="ChartPanel" Margin="0,8,0,0" />
                        <TextBlock Text="金色：5★ / 紫色：4★ / 橙色 UP；数字为距上次同档位的抽数。"
                                   FontSize="9.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 下方：固定页面高度，只有每个卡池内部记录列表滚动 -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.WindowBg}" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,4,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="15" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="抽卡记录" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="PoolScroll" Grid.Row="1" Margin="0,8,0,0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="PoolGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Margin="18,0,18,0" />
            </ScrollViewer>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.NavBg}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtStatus" Text="本地库为空 · 等待同步抽卡记录" FontSize="10"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TxtAccount" Text="未登录米游社" FontSize="9.5"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </Grid>
        </Border>

        <!-- 设置浮层 -->
        <Border x:Name="PanelSettings" Grid.Row="0" Grid.RowSpan="3" Width="390"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,16,0"
                Visibility="Collapsed" Panel.ZIndex="40"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="12" Padding="16,14">
            <StackPanel>
                <TextBlock Text="抽卡记录设置" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock x:Name="TxtDataDir" Text="数据目录：—" FontSize="10"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock Text="更新时优先读取游戏缓存中的 authkey；也可以使用当前米游社账号换取，失败会自动回退。"
                           FontSize="9.5" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                <CheckBox x:Name="ChkShow4" Content="记录区显示 4★" FontSize="10.5" IsChecked="True"
                          Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,12,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                <CheckBox x:Name="ChkShowIcon" Content="显示条目圆形图标" FontSize="10.5" IsChecked="True"
                          Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,7,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                    <Button Content="打开数据目录" Height="30" Padding="11,0" Style="{StaticResource GachaButton}"
                            Click="OpenDataDir_Click" />
                    <Button Content="关闭" Height="30" Padding="11,0" Style="{StaticResource GachaButton}"
                            Margin="7,0,0,0" Click="BtnSettings_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="TxtToast" Grid.Row="2" Background="{DynamicResource Brush.Card}" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Visibility="Collapsed" Panel.ZIndex="50" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <TextBlock x:Name="TxtToastText" Text="" FontSize="11.5" Foreground="{DynamicResource Brush.TextPrimary}" />
        </Border>
    </Grid>
</UserControl>
