<UserControl x:Class="MikoMiko.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True" Background="#0A0E14">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GachaPanel" Color="#111821" />
        <SolidColorBrush x:Key="GachaPanel2" Color="#161F2A" />
        <SolidColorBrush x:Key="GachaLine" Color="#26323F" />
        <SolidColorBrush x:Key="GachaText" Color="#E8F0F7" />
        <SolidColorBrush x:Key="GachaMuted" Color="#8B9AAB" />
        <SolidColorBrush x:Key="GachaGold" Color="#E0B15C" />

        <Style x:Key="GachaCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E8F0F7" />
            <Setter Property="Background" Value="#151D27" />
            <Setter Property="BorderBrush" Value="#2B3948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GachaButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D6E4F0" />
            <Setter Property="Background" Value="#151D27" />
            <Setter Property="BorderBrush" Value="#2B3948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1D2A38" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#4A6A85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GachaPrimaryButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Background" Value="#C9943B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9943B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GachaIconButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="GachaSideItem" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#C8D6E4" />
            <Setter Property="Background" Value="#151D27" />
            <Setter Property="BorderBrush" Value="#26323F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1C2937" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#42607A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="348" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="#0D1219" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="20" CornerRadius="1.5" Background="#C9943B"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="TxtHeaderTitle" Text="祈愿记录" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F1F6FB" VerticalAlignment="Center" />
                    <Button x:Name="BtnBeyond" Height="24" Margin="10,0,0,0" Padding="10,0"
                            Background="#1A2330" BorderBrush="#334457" BorderThickness="1"
                            Foreground="#CBB27C" FontSize="10.5" Cursor="Hand" Click="BtnBeyond_Click"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.86" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="千星奇域颂愿" FontSize="10.5" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="本地库 0 条 · MikoNest 数据" FontSize="10.5"
                           Foreground="#778697" Margin="12,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <Button x:Name="BtnMore" Content="⋯" Style="{StaticResource GachaIconButton}" Width="34"
                        Click="BtnMore_Click" ToolTip="更多操作" />
                <Button x:Name="BtnSettings" Content="⚙" Style="{StaticResource GachaIconButton}" Width="34"
                        Margin="6,0,0,0" Click="BtnSettings_Click" ToolTip="设置" />
            </StackPanel>
        </Grid>

        <!-- 左：账号与游戏 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0D131B" BorderBrush="#1E2833"
                BorderThickness="0,0,1,0" Padding="18,16,18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#141E2A" BorderBrush="#2A3746" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="游戏" FontSize="10" Foreground="#758697" />
                        <ComboBox x:Name="ComboGame" Margin="0,6,0,0" Style="{StaticResource GachaCombo}"
                                  SelectionChanged="ComboGame_SelectionChanged" />
                        <TextBlock Text="UID" FontSize="10" Foreground="#758697" Margin="0,10,0,0" />
                        <ComboBox x:Name="ComboUid" Margin="0,6,0,0" Style="{StaticResource GachaCombo}"
                                  SelectionChanged="ComboUid_SelectionChanged" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnUpdate" Grid.Row="1" Content="更新记录" Height="40"
                        Style="{StaticResource GachaPrimaryButton}" Margin="0,12,0,0"
                        Click="BtnUpdate_Click" />

                <Border Grid.Row="2" Background="#111821" BorderBrush="#232E3A" BorderThickness="1"
                        CornerRadius="10" Padding="13,10" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="当前记录" FontSize="10" Foreground="#758697" />
                        <TextBlock x:Name="TxtSidebarStats" Text="0 条" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#E7D3A7" Margin="0,4,0,0" />
                        <TextBlock x:Name="TxtUid" Text="UID —" FontSize="10"
                                   Foreground="#8797A8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock Text="快捷操作" FontSize="10" Foreground="#758697" Margin="2,0,0,8" />
                    <Button Content="导出 CSV" Style="{StaticResource GachaSideItem}" Click="ExportCsv_Click" />
                    <Button Content="打开记录目录" Style="{StaticResource GachaSideItem}" Click="OpenDataDir_Click" />
                </StackPanel>

                <TextBlock Grid.Row="4" x:Name="TxtAccount" Text="未登录米游社" FontSize="10"
                           Foreground="#6F8093" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 中：统计概览 -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0B1017" BorderBrush="#1E2833"
                BorderThickness="0,0,1,0" Padding="18,16,18,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="记录概览" FontSize="14" FontWeight="SemiBold" Foreground="#EDF4FA" />
                    <TextBlock x:Name="TxtSummarySub" Text="选择 UID 后开始统计" FontSize="10"
                               Foreground="#77889A" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <Border Background="#121B25" BorderBrush="#273443" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,13,0,0">
                        <StackPanel x:Name="SummaryPanel" />
                    </Border>

                    <TextBlock Text="出货分布" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCE7F2"
                               Margin="2,18,0,0" />
                    <Border Background="#121B25" BorderBrush="#273443" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
                        <StackPanel x:Name="ChartPanel" />
                    </Border>

                    <TextBlock Text="记录明细图例" FontSize="10" Foreground="#6E7F91" Margin="2,14,0,0" />
                    <TextBlock Text="金色：5★ / 紫色：4★ / 橙色 UP 标记；数字为距上次同档位的抽数。"
                               FontSize="9.5" Foreground="#617283" TextWrapping="Wrap" Margin="2,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：卡池列 -->
        <Grid Grid.Row="1" Grid.Column="2" Background="#0A0E14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="祈愿记录" FontSize="13" FontWeight="SemiBold" Foreground="#E8F0F7"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="横向滑动查看更多卡池 →" FontSize="9.5"
                           Foreground="#647586" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer x:Name="PoolScroll" Grid.Row="1" Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="PoolGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="18,0,18,0" />
            </ScrollViewer>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#0D1219" BorderBrush="#1E2833"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Ellipse Width="6" Height="6" Fill="#C9943B" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtStatus" Text="本地库为空 · 等待同步抽卡记录" FontSize="10"
                           Foreground="#8B9AAB" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 设置浮层 -->
        <Border x:Name="PanelSettings" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Width="390"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,16,0"
                Visibility="Collapsed" Panel.ZIndex="40"
                Background="#131C27" BorderBrush="#354658" BorderThickness="1" CornerRadius="12"
                Padding="16,14">
            <StackPanel>
                <TextBlock Text="抽卡记录设置" FontSize="13" FontWeight="SemiBold" Foreground="#EEF5FB" />
                <TextBlock x:Name="TxtDataDir" Text="数据目录：—" FontSize="10" Foreground="#8495A6"
                           TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock Text="更新时优先读取游戏缓存中的 authkey；也可以使用当前米游社账号换取，失败会自动回退。"
                           FontSize="9.5" Foreground="#6F8093" TextWrapping="Wrap" Margin="0,5,0,0" />
                <CheckBox x:Name="ChkShow4" Content="记录区显示 4★" FontSize="10.5" IsChecked="True"
                          Foreground="#BCCBD9" Margin="0,12,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                <CheckBox x:Name="ChkShowIcon" Content="显示条目圆形图标" FontSize="10.5" IsChecked="True"
                          Foreground="#BCCBD9" Margin="0,7,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                    <Button Content="打开数据目录" Height="30" Padding="11,0" Style="{StaticResource GachaButton}"
                            Click="OpenDataDir_Click" />
                    <Button Content="关闭" Height="30" Padding="11,0" Style="{StaticResource GachaButton}"
                            Margin="7,0,0,0" Click="BtnSettings_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="TxtToast" Grid.Row="1" Background="#EE18222E" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Visibility="Collapsed" Panel.ZIndex="50" BorderBrush="#3C4E62" BorderThickness="1">
            <TextBlock x:Name="TxtToastText" Text="" FontSize="11.5" Foreground="#EAF6FF" />
        </Border>
    </Grid>
</UserControl>
