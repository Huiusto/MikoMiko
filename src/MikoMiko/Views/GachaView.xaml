<UserControl x:Class="MikoMiko.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True" Background="#EDF2F8">
    <UserControl.Resources>
        <Style x:Key="GachaCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4E3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GachaButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4E3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#EAF7FF" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#8CC9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GachaPrimaryButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Background" Value="#258DD1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#258DD1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GachaIconButton" TargetType="Button" BasedOn="{StaticResource GachaButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="29" CornerRadius="2" Background="#258DD1"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="TxtHeaderTitle" Text="祈愿记录" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <Button x:Name="BtnBeyond" Height="28" Margin="12,0,0,0" Padding="12,0"
                            Background="#EAF7FF" BorderBrush="#CBE8FA" BorderThickness="1"
                            Foreground="#2A78A8" FontSize="11" Cursor="Hand" Click="BtnBeyond_Click"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="14" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="千星奇域颂愿" FontSize="11" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="本地库 0 条 · 数据来自 MikoNest" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="13,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <ComboBox x:Name="ComboGame" Width="132" Style="{StaticResource GachaCombo}"
                          SelectionChanged="ComboGame_SelectionChanged" />
                <ComboBox x:Name="ComboUid" Width="190" Style="{StaticResource GachaCombo}" Margin="8,0,0,0"
                          SelectionChanged="ComboUid_SelectionChanged" />
                <Button x:Name="BtnUpdate" Content="更新记录" Width="104" Style="{StaticResource GachaPrimaryButton}"
                        Margin="8,0,0,0" Click="BtnUpdate_Click" />
                <Button x:Name="BtnMore" Content="⌄" Style="{StaticResource GachaIconButton}" Margin="8,0,0,0"
                        Click="BtnMore_Click" ToolTip="更多操作" />
                <Button x:Name="BtnSettings" Content="⚙  设置" Style="{StaticResource GachaButton}"
                        Margin="8,0,0,0" Click="BtnSettings_Click" />
            </StackPanel>
        </Grid>

        <!-- 设置面板（默认折叠） -->
        <Border x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0"
                Background="#FFFFFF" BorderBrush="#DCE8F2" BorderThickness="1" CornerRadius="10"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="抽卡记录设置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock x:Name="TxtDataDir" Text="数据目录：—" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                    <TextBlock Text="记录来自 MikoNest 本地抽卡库；在游戏内打开一次抽卡记录页面会刷新 authkey。"
                               FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导出 CSV" Height="32" Padding="12,0" Style="{StaticResource GachaButton}"
                            Click="ExportCsv_Click" Margin="0,0,6,0" />
                    <Button Content="打开数据目录" Height="32" Padding="12,0" Style="{StaticResource GachaButton}"
                            Click="OpenDataDir_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 卡池分列（固定宽度，横向可滚动，仿 MikoNest 抽卡记录页） -->
        <ScrollViewer x:Name="PoolScroll" Grid.Row="2" Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="PoolGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
        </ScrollViewer>

        <Border x:Name="TxtToast" Grid.Row="2" Background="#E6112230" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Visibility="Collapsed" Panel.ZIndex="10">
            <TextBlock x:Name="TxtToastText" Text="" FontSize="12" Foreground="#EAF6FF" />
        </Border>
    </Grid>
</UserControl>
