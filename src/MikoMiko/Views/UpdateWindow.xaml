<Window x:Class="MikoMiko.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikoMiko 更新" Width="960" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Border CornerRadius="28" Background="White" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.20" Color="#6A92B9" />
            </Border.Effect>
            <Grid>
                <Image Source="/Assets/Setup/update-notice-full.png" Stretch="Fill" />

                <!-- 版本号覆盖图内烘焙的 V1.8.0，始终显示当前检测到的新版本 -->
                <Border Width="140" Height="36" Background="#F8FAFD"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="624,299,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="633,303,0,0">
                    <TextBlock Text="版本" FontSize="18" FontWeight="SemiBold" Foreground="#6B8AAA" />
                    <TextBlock x:Name="VersionText" FontSize="18" FontWeight="SemiBold" Foreground="#2C7FC4"
                               Margin="5,0,0,0" />
                </StackPanel>

                <!-- 图内自带关闭 ×：透明热点 -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Width="46" Height="38"
                        Margin="898,20,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 图内自带「忽略」「更新」按钮：透明热点承接原有点击逻辑 -->
                <Button x:Name="IgnoreButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="310" Height="50" Margin="148,515,0,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click" ToolTip="忽略此版本">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="InstallButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="320" Height="50" Margin="520,515,0,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Install_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 下载/安装状态浮层，默认隐藏，不遮挡原图 -->
                <Border x:Name="DownloadPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                        Background="#F4FFFFFF" BorderBrush="#D7E8FA" BorderThickness="1"
                        CornerRadius="14" Padding="18,10" MinWidth="460">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#5F7F9A"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <ProgressBar x:Name="DownloadProgress" Height="7" Minimum="0" Maximum="1" Value="0"
                                     Margin="0,8,0,0" Foreground="#63A7DB" Background="#E6F1FB"
                                     BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track" CornerRadius="3.5" Background="#E6F1FB" />
                                        <Border x:Name="PART_Indicator" CornerRadius="3.5" Background="#63A7DB"
                                                HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- 代码兼容占位：新提示图不再显示更新说明文本 -->
                <TextBlock x:Name="NotesText" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
