<Window x:Class="MikoMiko.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikoMiko 更新" Width="540" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}">
                <Path Data="M12 3 V17 M6 8 L12 2 L18 8 M4 18 H20" Stroke="{DynamicResource Brush.Accent}"
                      StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="发现新版本" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,20,0,8" Text="更新内容" FontSize="13.5" FontWeight="SemiBold" />

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="22" FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="1" Value="0"
                         Visibility="Collapsed" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Content="打开 Release 页面" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Click="OpenRelease_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消（忽略本次）" Style="{StaticResource GhostButton}" Height="36" Padding="16,0"
                        Click="Cancel_Click" />
                <Button x:Name="InstallButton" Content="立即更新" Style="{StaticResource AccentButton}"
                        Height="36" Padding="22,0" Margin="10,0,0,0" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
