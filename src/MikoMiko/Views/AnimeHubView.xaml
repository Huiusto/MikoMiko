<UserControl x:Class="MikoMiko.Views.AnimeHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True">
    <UserControl.Resources>
    <Style x:Key="FilterButton" TargetType="Button">
        <Setter Property="Background" Value="#F2FFFFFF" />
        <Setter Property="Foreground" Value="#24384F" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="17" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="B" Property="BorderBrush" Value="#BBD5EC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</UserControl.Resources>

<Grid Margin="26,18,26,14" Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部通栏横幅：筛选、我追的、搜索框全部叠在图片上 -->
        <Border Grid.Row="0" Height="232" CornerRadius="14" Margin="0,0,0,14" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Anime/anime-banner.png"
                            Stretch="UniformToFill" AlignmentY="Center" />
            </Border.Background>
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#780B1724" Offset="0" />
                            <GradientStop Color="#000B1724" Offset="0.38" />
                            <GradientStop Color="#A60A1522" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 左上：分类；右上：我追的 -->
                <Grid VerticalAlignment="Top" Margin="18,16,18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnAll" Content="全部" Tag="all" Click="Filter_Click" Style="{StaticResource FilterButton}"
                                Height="34" Padding="17,0" FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
                        <Button x:Name="BtnBangumi" Content="番剧" Tag="bangumi" Click="Filter_Click" Style="{StaticResource FilterButton}"
                                Height="34" Padding="17,0" FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
                        <Button x:Name="BtnConcert" Content="音乐会" Tag="concert" Click="Filter_Click" Style="{StaticResource FilterButton}"
                                Height="34" Padding="17,0" FontSize="12" Cursor="Hand" />
                    </StackPanel>
                    <Button x:Name="BtnFollowed" Content="★  我追的" Tag="followed" Click="Followed_Click"
                            HorizontalAlignment="Right" Height="34" Padding="17,0" FontSize="12"
                            Cursor="Hand" Style="{StaticResource FilterButton}" />
                </Grid>

                <!-- 图片上的搜索框 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,20"
                        Width="430" Height="42" CornerRadius="21" Background="#F5FFFFFF"
                        BorderBrush="#66FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="21" Foreground="#6E8296"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                     Background="Transparent" BorderThickness="0" FontSize="13"
                                     Foreground="#1F3247" VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索番剧、电影、电视剧" FontSize="13"
                                       Foreground="#8EA1B3" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Click="ClearSearch_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#8EA1B3"
                                FontSize="12" Cursor="Hand" Margin="0,0,12,0" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtStatus" Text="正在读取作品信息…" FontSize="10.5"
                           Foreground="#EAF3FA" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,22,24" TextTrimming="CharacterEllipsis" MaxWidth="560" />
            </Grid>
        </Border>

        <!-- 内容 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" />
        </ScrollViewer>

        <ScrollViewer x:Name="FollowScroll" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="4" Height="22" CornerRadius="2" Background="#4B7BC8"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="我追的" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel x:Name="FollowPanel" />
                <TextBlock x:Name="FollowEmpty" Text="还没有追番作品。打开任意作品，在播放页点击「追番」就会同步到这里。"
                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                           Margin="4,20,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ToastPanel" Grid.Row="1" Background="#E6112230" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Visibility="Collapsed" Panel.ZIndex="20">
            <TextBlock x:Name="ToastText" FontSize="12" Foreground="#EAF6FF" />
        </Border>
    </Grid>
</UserControl>
