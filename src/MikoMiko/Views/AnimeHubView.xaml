<UserControl x:Class="MikoMiko.Views.AnimeHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True">
    <UserControl.Resources>
    <Style x:Key="FilterButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="#DCE8F3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="17" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#9EC2E8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</UserControl.Resources>

<Grid Margin="26,18,26,14" Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="29" CornerRadius="2" Background="#4B7BC8"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="追剧 / 影视" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <Border Background="#EEF4FF" BorderBrush="#D6E3F7" BorderThickness="1"
                            CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="哔哩哔哩 · 正版" FontSize="10.5" Foreground="#52709E" />
                    </Border>
                </StackPanel>
                <TextBlock Text="精选番剧与官方音乐会，点击卡片即可在软件内观看"
                           FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="13,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" BorderBrush="#DCE8F3" BorderThickness="1"
                        CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="17" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#3F6FAF" />
                        <TextBlock Text="部作品" FontSize="9.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#DCE8F3" BorderThickness="1"
                        CornerRadius="12" Padding="14,8">
                    <StackPanel>
                        <TextBlock Text="在线" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#359B5A" />
                        <TextBlock Text="软件内播放" FontSize="9.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 分类切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,2">
            <Button x:Name="BtnAll" Content="全部 17" Tag="all" Click="Filter_Click" Style="{StaticResource FilterButton}"
                    Height="34" Padding="18,0" FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
            <Button x:Name="BtnBangumi" Content="番剧 7" Tag="bangumi" Click="Filter_Click" Style="{StaticResource FilterButton}"
                    Height="34" Padding="18,0" FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
            <Button x:Name="BtnConcert" Content="音乐会 10" Tag="concert" Click="Filter_Click" Style="{StaticResource FilterButton}"
                    Height="34" Padding="18,0" FontSize="12" Cursor="Hand" />
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" />
        </ScrollViewer>

        <!-- 底部状态 -->
        <Border Grid.Row="3" Margin="0,10,0,0" Background="#FFFFFF" BorderBrush="#E2ECF5"
                BorderThickness="1" CornerRadius="10" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="正在读取作品信息…" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="直连播放失败时自动切换为软件内网页播放"
                           FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" />
            </Grid>
        </Border>

        <Border x:Name="ToastPanel" Grid.Row="2" Background="#E6112230" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Visibility="Collapsed" Panel.ZIndex="20">
            <TextBlock x:Name="ToastText" FontSize="12" Foreground="#EAF6FF" />
        </Border>
    </Grid>
</UserControl>
