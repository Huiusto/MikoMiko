<UserControl x:Class="MikoMiko.Views.MineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Margin="26,18,18,30" MaxWidth="1240" HorizontalAlignment="Stretch">

                <!-- ============ 未登录：扫码登录引导 ============ -->
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="40,44"
                        HorizontalAlignment="Center" MaxWidth="640" Margin="0,30,0,0"
                        Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                        <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True"
                                Background="{DynamicResource Brush.Card}" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock Text="{Binding [Mine.GuestTitle], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />

                        <TextBlock Text="{Binding [Mine.GuestHint], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                        <Button Content="{Binding [Mine.QrLogin], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource AccentButton}" Height="42" Padding="28,0" Margin="0,22,0,0"
                                HorizontalAlignment="Center" Command="{Binding LoginCommand}" />

                        <TextBlock Text="{Binding [Mine.QrHint], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <TextBlock Text="{Binding BindStatus}" FontSize="12" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Brush.Accent}" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding BindStatus, Converter={StaticResource NotEmptyToVis}}" />

                        <!-- Cookie 备用登录 -->
                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="18,14"
                                Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [Mine.CookieFallback], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding [Mine.CookieHint], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding CookieInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Width="330" Height="34" />
                                    <Button Content="{Binding [Mine.BindButton], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource SoftButton}" Height="34" Padding="14,0" Margin="8,0,0,0"
                                            Command="{Binding BindCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ 已登录 ============ -->
                <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">

                    <!-- 账号卡片 -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Card}" VerticalAlignment="Top">
                                <Image controls:AsyncImage.Url="{Binding Profile.Avatar}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Profile.Nickname}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="6,1"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profile.LevelText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Text="{Binding [Mine.Bound], Source={x:Static loc:Loc.Instance}}"
                                                   FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Profile.Signature}" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Profile.Uid, StringFormat=UID {0}}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,10,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding NicknameDraft, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Width="220" Height="34" />
                                    <Button Content="{Binding [Mine.Save], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource AccentButton}" Height="34" Padding="16,0"
                                            Margin="8,0,0,0" Command="{Binding ToggleEditCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                                <Button Content="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                        Command="{Binding RefreshCommand}" />
                                <Button Content="{Binding [Mine.Logout], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding UnbindCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 数据统计 -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="8,16" Margin="0,12,0,0">
                        <UniformGrid Columns="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Profile.Following}" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Mine.Following], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Profile.Fans}" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Mine.Fans], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Profile.Likes}" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Mine.Likes], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Profile.Views}" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Mine.Views], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- 游戏账号（接口有数据时展示） -->
                    <TextBlock Text="{Binding [Mine.Games], Source={x:Static loc:Loc.Instance}}"
                               FontSize="15.5" FontWeight="SemiBold" Margin="4,24,0,12" />

                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="16,15"
                                        Margin="0,0,12,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="15" CornerRadius="2" Background="{Binding Accent}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="5,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Server}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Uid}" FontSize="11.5" Margin="13,8,0,0"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />

                                        <Grid Margin="13,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Level}" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding [Mine.Game.Level], Source={x:Static loc:Loc.Instance}}"
                                                           FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Extra}" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ExtraLabel}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding [Mine.GamesEmpty], Source={x:Static loc:Loc.Instance}}"
                               FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="4,0,0,0"
                               Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVis}}" />

                    <!-- 我的收藏 -->
                    <StackPanel Orientation="Horizontal" Margin="4,24,0,12">
                        <TextBlock Text="{Binding [Mine.Favorites], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Mine.Favorites.Hint], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Margin="0,0,12,12"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <Grid Height="118">
                                            <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border Height="26" VerticalAlignment="Bottom" Background="{DynamicResource Brush.CoverMask}" />
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10.5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,9,10,10"
                                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding [Mine.EmptyFavorites], Source={x:Static loc:Loc.Instance}}"
                               Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12.5" Margin="4,0,0,0"
                               Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
