<UserControl x:Class="MikoMiko.Views.MineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />

        <LinearGradientBrush x:Key="ProfileBanner" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4EA4DD" Offset="0" />
            <GradientStop Color="#63B8E8" Offset="0.55" />
            <GradientStop Color="#8FD3F4" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Margin="26,18,18,30" MaxWidth="1240" HorizontalAlignment="Stretch">

                <!-- ============ 未登录：应用内扫码 ============ -->
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="36,34"
                        HorizontalAlignment="Center" MaxWidth="700" Margin="0,26,0,0"
                        Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                        <Border Width="78" Height="78" CornerRadius="39" ClipToBounds="True"
                                Background="{DynamicResource Brush.Card}" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock Text="登录米游社" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="在当前页面内扫码登录，登录后同步个人主页与游戏角色，不会另开窗口。"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />

                        <Button Content="扫码登录" Style="{StaticResource AccentButton}" Height="42" Padding="30,0"
                                Margin="0,18,0,0" HorizontalAlignment="Center"
                                Command="{Binding LoginCommand}"
                                Visibility="{Binding IsQrOpen, Converter={StaticResource InverseBoolToVis}}" />

                        <!-- 二维码面板（内嵌，不新开窗口） -->
                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsQrOpen, Converter={StaticResource BoolToVis}}">
                            <Border Width="228" Height="228" Background="White" CornerRadius="10" Padding="10"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Image Source="{Binding QrImage}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{Binding LoginStatus}" FontSize="12" Margin="0,12,0,0"
                                       TextAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="刷新二维码" Style="{StaticResource SoftButton}" Height="32" Padding="14,0"
                                        Command="{Binding RefreshQrCommand}" />
                                <Button Content="取消" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                        Command="{Binding CancelLoginCommand}" />
                            </StackPanel>
                            <TextBlock Text="打开米游社 App → 右上角扫一扫 → 确认登录"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding BindStatus}" FontSize="12" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Brush.Accent}" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding BindStatus, Converter={StaticResource NotEmptyToVis}}" />

                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="16,12"
                                Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="Cookie 备用登录" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Text="{Binding CookieInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Width="350" Height="34" />
                                    <Button Content="绑定" Style="{StaticResource SoftButton}" Height="34" Padding="16,0"
                                            Margin="8,0,0,0" Command="{Binding BindCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ 已登录：个人主页 ============ -->
                <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">

                    <Border CornerRadius="16" ClipToBounds="True" Background="{StaticResource ProfileBanner}"
                            Height="236">
                        <Grid>
                            <!-- 用户自定义背景图 -->
                            <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
                                   Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#40000000"
                                    Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}" />

                            <!-- 装饰圆 -->
                            <Ellipse Width="280" Height="280" Fill="#33FFFFFF" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,-100,-60,0" />
                            <Ellipse Width="180" Height="180" Fill="#22FFFFFF" HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom" Margin="0,0,120,-80" />

                            <StackPanel Margin="30,26,30,24">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="88" Height="88" CornerRadius="44" ClipToBounds="True"
                                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="2">
                                        <Image controls:AsyncImage.Url="{Binding Profile.Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Margin="18,4,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Profile.Nickname}" FontSize="23" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Profile.Uid, StringFormat=米游社 UID {0}}" FontSize="12"
                                                   Foreground="#E8FFFFFF" Margin="0,7,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,2">
                                                <TextBlock Text="{Binding Profile.IpText}" FontSize="10.5" Foreground="White" />
                                            </Border>
                                            <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,2" Margin="6,0,0,0">
                                                <TextBlock Text="社区创作者" FontSize="10.5" Foreground="White" />
                                            </Border>
                                            <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,2" Margin="6,0,0,0">
                                                <TextBlock Text="米游社" FontSize="10.5" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding Profile.Signature}" FontSize="13" Foreground="#F2FFFFFF"
                                           Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding Profile.Fans}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="粉丝" FontSize="11" Foreground="#D9FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding Profile.Following}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="关注" FontSize="11" Foreground="#D9FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding Profile.Likes}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="获赞" FontSize="11" Foreground="#D9FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Profile.Views}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="发帖" FontSize="11" Foreground="#D9FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右上角：圆润刷新 / 退出 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,18,18,0">
                                <Button Height="32" Padding="16,0" Cursor="Hand" Command="{Binding RefreshCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" CornerRadius="16" Background="#47FFFFFF"
                                                    BorderBrush="#66FFFFFF" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="刷新资料" Foreground="White" FontSize="12" />
                                </Button>
                                <Button Height="32" Padding="16,0" Margin="8,0,0,0" Cursor="Hand" Command="{Binding UnbindCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" CornerRadius="16" Background="#30FFFFFF"
                                                    BorderBrush="#55FFFFFF" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#52FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="退出登录" Foreground="White" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <!-- 右下角：恢复默认背景 / 更换背景 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,18,16">
                                <Button Width="32" Height="32" Cursor="Hand" Margin="0,0,8,0"
                                        Command="{Binding RestoreDefaultBackgroundCommand}" ToolTip="恢复默认背景"
                                        Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" CornerRadius="16" Background="#40000000"
                                                    BorderBrush="#55FFFFFF" BorderThickness="1">
                                                <Path Data="M4 8 A5 5 0 1 1 6 12.5 M4 8 V3.5 M4 8 H8.5"
                                                      Stroke="White" StrokeThickness="1.3" Width="13" Height="13"
                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#66000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Height="32" Padding="14,0" Cursor="Hand" Command="{Binding ChangeBackgroundCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd" CornerRadius="16" Background="#40000000"
                                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#66000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 5 H20 V19 H4 Z M6 17 L10 12 L13 15 L16 11 L20 17"
                                          Stroke="White" StrokeThickness="1.3" Width="12" Height="11"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="更换背景" Foreground="White" FontSize="12" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 角色管理：标题前的小设置入口，可自定义显示与排序 -->
                    <Grid Margin="4,24,4,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="GameSettingsButton" Width="26" Height="26" Padding="0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Focusable="False"
                                    Margin="0,0,8,0" ToolTip="自定义游戏显示与顺序"
                                    Command="{Binding ToggleGameSettingsCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                                            <Path Data="M8 1.2 A2.1 2.1 0 1 0 8 5.4 A2.1 2.1 0 1 0 8 1.2 M8 5.4 V8.4 M8 11.6 V14.8 M1.2 8 H3.6 M12.4 8 H14.8 M3.2 3.2 L4.9 4.9 M11.1 11.1 L12.8 12.8 M12.8 3.2 L11.1 4.9 M4.9 11.1 L3.2 12.8"
                                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.2"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="角色管理" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="已绑定游戏角色" FontSize="12" Margin="10,2,0,0"
                                       Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="数据来自米游社绑定角色" FontSize="11.5" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>

                    <Popup IsOpen="{Binding IsGameSettingsOpen}" PlacementTarget="{Binding ElementName=GameSettingsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="4" VerticalOffset="6">
                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="14,12"
                                Width="330" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#33000000" BlurRadius="16" ShadowDepth="3" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="游戏角色显示" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="勾选要展示的游戏，使用箭头调整顺序。" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,10" />
                                <ItemsControl ItemsSource="{Binding Games}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Background="Transparent" BorderThickness="0" Padding="2,4"
                                                        HorizontalContentAlignment="Left" Cursor="Hand"
                                                        Command="{Binding DataContext.ToggleGameVisibleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="15" Height="15" CornerRadius="4"
                                                                Background="{DynamicResource Brush.Card}"
                                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <Path Data="M1 5 L4 8 L9 1" Stroke="{DynamicResource Brush.Accent}"
                                                                  StrokeThickness="1.6" Width="9" Height="8" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding GameName}" FontSize="11.5" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding RoleName}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Content="↑" Style="{StaticResource LinkButton}"
                                                        Width="24" Padding="0" FontSize="12"
                                                        Command="{Binding DataContext.MoveGameUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="↓" Style="{StaticResource LinkButton}"
                                                        Width="24" Padding="0" FontSize="12"
                                                        Command="{Binding DataContext.MoveGameDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="至少保留一个游戏时页面更完整。" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ItemsControl ItemsSource="{Binding VisibleGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="14,13"
                                        Margin="0,0,12,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource Brush.Card}" ClipToBounds="True">
                                                <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="4" Padding="5,1"
                                                            Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}" FontSize="9"
                                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RoleName}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Level}" FontSize="20" FontWeight="Bold"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Uid, StringFormat=UID {0}}" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,7,0,0" />
                                        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,7,0,0"
                                                      Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="6"
                                                            Padding="7,5" Margin="0,0,5,5">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Label}" FontSize="9"
                                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="18,20" Margin="0,2,12,0"
                            Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVis}}">
                        <StackPanel>
                            <TextBlock Text="暂未读取到游戏角色" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="请在米游社「我的」中绑定游戏角色后重新刷新；部分角色数据需要对应游戏战绩接口。"
                                       FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 我的发布 -->
                    <!-- 四个内容入口合并为一栏按钮，只显示当前选择 -->
                    <ItemsControl ItemsSource="{Binding MineTabs}" Margin="4,20,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,0" Padding="18,8" Cursor="Hand" BorderThickness="0"
                                        Background="Transparent"
                                        Command="{Binding DataContext.SelectMineTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd" CornerRadius="16"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="12.5"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowPostsTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,12">
                        <TextBlock Text="我的发布" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="你自己发布过的内容" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MyPosts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Margin="0,0,12,12"
                                        Command="{Binding DataContext.OpenMyPostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid Height="118">
                                                <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                                <Border Height="26" VerticalAlignment="Bottom" Background="{DynamicResource Brush.CoverMask}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,9,10,5"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" FontSize="10.5" Margin="10,0,10,10"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有发布过内容" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="12.5" Margin="4,0,0,0"
                               Visibility="{Binding HasNoMyPosts, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 我的评论 -->
                    <StackPanel Visibility="{Binding ShowRepliesTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,12">
                        <TextBlock Text="我的评论" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="你自己发布过的评论" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MyReplies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Margin="0,0,12,12"
                                        Command="{Binding DataContext.OpenMyReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="13,11">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="12.5" LineHeight="19"
                                                       TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PostTitle}" FontSize="10.5" Margin="0,7,0,0"
                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeText, StringFormat=发布 {0}}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有发布过评论" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="12.5" Margin="4,0,0,0"
                               Visibility="{Binding HasNoReplies, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 我的合集 -->
                    <StackPanel Visibility="{Binding ShowCollectionsTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,12">
                        <TextBlock Text="我的合集" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="你自己创建过的合集" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MyCollections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Margin="0,0,12,12"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <Grid Height="108">
                                            <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border Height="28" VerticalAlignment="Bottom" Background="{DynamicResource Brush.CoverMask}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,8,10,4"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" FontSize="10.5" Margin="10,0,10,10"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有创建过合集" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="12.5" Margin="4,0,0,0"
                               Visibility="{Binding HasNoCollections, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 我的收藏 -->
                    <StackPanel Visibility="{Binding ShowFavoritesTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,12">
                        <TextBlock Text="我的收藏" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="收藏的帖子会显示在这里" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Margin="0,0,12,12"
                                        Command="{Binding DataContext.OpenMyPostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" ClipToBounds="True">
                                    <StackPanel>
                                        <Grid Height="118">
                                            <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border Height="26" VerticalAlignment="Bottom" Background="{DynamicResource Brush.CoverMask}" />
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10.5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,9,10,10"
                                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有收藏的帖子" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="12.5" Margin="4,0,0,0"
                               Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 更换背景：选图后自己选择要显示的区域（软件内裁剪，不新开窗口） -->
        <Grid Background="#CC000000" Visibility="{Binding IsCropOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="760" Background="{DynamicResource Brush.WindowBg}" CornerRadius="14" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="选择背景显示区域" FontSize="18" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                Content="关闭" Command="{Binding CancelBackgroundCropCommand}" />
                    </Grid>
                    <TextBlock Text="拖动下方滑块，决定这张图在主页横幅里显示哪一块；确认后按所选区域裁切保存。斑马线内为自定义背景的实际显示区域。"
                               FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,14"
                               TextWrapping="Wrap" />

                    <Grid Height="300" ClipToBounds="True">
                        <Border CornerRadius="12" Background="#101418">
                            <Image Source="{Binding CropPreview}" Stretch="UniformToFill" />
                        </Border>
                        <Border Margin="10" BorderThickness="3" CornerRadius="8" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute"
                                              Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Geometry="M0,0 L10,10 M10,0 L0,10">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#CCFFFFFF" Thickness="2" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="水平位置" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CropOffsetX}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CropOffsetX, StringFormat={}{0:P0}}"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />

                        <TextBlock Grid.Row="1" Text="垂直位置" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CropOffsetY}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CropOffsetY, StringFormat={}{0:P0}}"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />

                        <TextBlock Grid.Row="2" Text="缩放区域" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.35" Maximum="1" Value="{Binding CropZoom}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CropZoom, StringFormat={}{0:P0}}"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="取消" Style="{StaticResource SoftButton}" Height="36" Padding="20,0"
                                Command="{Binding CancelBackgroundCropCommand}" />
                        <Button Content="使用此区域" Style="{StaticResource AccentButton}" Height="36" Padding="24,0"
                                Margin="10,0,0,0" Command="{Binding ConfirmBackgroundCropCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 游戏角色详情（点击角色卡打开） -->
        <Grid Background="#CC000000" Visibility="{Binding IsGameDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="860" MaxHeight="700" Background="{DynamicResource Brush.WindowBg}" CornerRadius="14"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="44" CornerRadius="3" Background="{Binding SelectedGame.Accent}" />
                            <StackPanel Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedGame.GameName}" FontSize="19" FontWeight="SemiBold" />
                                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="4" Padding="6,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Badge}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </Border>
                                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="7,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameLevelText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding GameRoleName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding GameUidText}" FontSize="11.5" Margin="12,0,0,0"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                                Cursor="Hand" Command="{Binding CloseGameDetailCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" CornerRadius="16" Background="{DynamicResource Brush.Card}">
                                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextSecondary}"
                                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
                            Padding="14,12" Margin="0,14,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="战绩详情" FontSize="13.5" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding GameSummary}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="6,1"
                                            Margin="8,0,0,0" Visibility="{Binding GameDataPublic, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="公开" FontSize="10" Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GameStats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Card}" CornerRadius="9"
                                                    Padding="11,10" Margin="0,0,9,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5"
                                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"
                                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="官方战绩卡片只返回公开统计；未公开的宝箱、神瞳等扩展数据不会伪造显示。"
                                       FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="该游戏的最新帖子" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameStatus}" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,2,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GamePosts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch" Margin="0,0,12,12"
                                                Command="{Binding DataContext.OpenGamePostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                                                    ClipToBounds="True">
                                                <StackPanel>
                                                    <Grid Height="116">
                                                        <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                                        <Border Height="26" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource Brush.CoverMask}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,8,10,4"
                                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" FontSize="10.5" Margin="10,0,10,10"
                                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
