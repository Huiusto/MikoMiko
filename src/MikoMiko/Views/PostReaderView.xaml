<UserControl x:Class="MikoMiko.Views.PostReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             xmlns:conv="clr-namespace:MikoMiko.Converters"
             FontFamily="{DynamicResource Font.Ui}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                        Command="{Binding CloseCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9 1 L2 7 L9 13" Stroke="{DynamicResource Brush.TextSecondary}"
                              StrokeThickness="1.5" Width="9" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Common.Back], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4"
                        Padding="7,2" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ForumName, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="{Binding ForumName}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" />
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding [Post.Read], Source={x:Static loc:Loc.Instance}}"
                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding [Common.OpenInBrowser], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource LinkButton}" Height="30" Padding="10,0"
                            Command="{Binding OpenInBrowserCommand}" />
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="30" Margin="8,0,0,0"
                            Command="{Binding CloseCommand}" ToolTip="{Binding [Common.Close], Source={x:Static loc:Loc.Instance}}">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{DynamicResource Brush.TextPrimary}"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 正文 -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="24,20,16,34">

                <!-- 作者：头像 / 昵称可点击进入用户主页，右侧关注同步官方 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource LinkButton}" Padding="0" Command="{Binding OpenAuthorCommand}">
                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True"
                                Background="{DynamicResource Brush.Card}">
                            <Image controls:AsyncImage.Url="{Binding AuthorAvatar}" Stretch="UniformToFill" />
                        </Border>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" HorizontalContentAlignment="Left"
                            Margin="10,0,0,0" Padding="0" Command="{Binding OpenAuthorCommand}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Author}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding TimeText}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                <TextBlock Text="{Binding ViewText, StringFormat={}{0} 浏览}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="{Binding FollowText}" Style="{StaticResource AccentButton}"
                            Height="30" Padding="16,0" VerticalAlignment="Center" FontSize="11.5"
                            Command="{Binding FollowAuthorCommand}" />
                </Grid>

                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                           LineHeight="30" Margin="0,16,0,0" />

                <!-- 官方话题标签，保留 #标签# 样式 -->
                <ItemsControl ItemsSource="{Binding Topics}" Margin="0,10,0,0"
                              Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.TagBlueBg}" CornerRadius="10"
                                    Padding="9,3" Margin="0,0,7,6">
                                <TextBlock Text="{Binding StringFormat=#{0}#}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TagBlue}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 正文：按官方 structured_content 顺序混排文本 / 图片 / 视频，保留字号/颜色/粗体/链接 -->
                <ItemsControl ItemsSource="{Binding Blocks}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <controls:RichTextBlock Runs="{Binding Runs}"
                                                        FontSize="14" LineHeight="25" TextWrapping="Wrap"
                                                        Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"
                                                        Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                <Border CornerRadius="10" ClipToBounds="True" Margin="0,2,0,14"
                                        Background="{DynamicResource Brush.Card}" HorizontalAlignment="Center"
                                        MaxWidth="820" Cursor="Hand" Tag="{Binding Url}" MouseLeftButtonUp="InlineImage_Click"
                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                    <Image controls:AsyncImage.Url="{Binding Url}" Stretch="Uniform" MaxHeight="620" />
                                </Border>
                                <Border CornerRadius="10" ClipToBounds="True" Margin="0,2,0,14" Height="220"
                                        Background="{DynamicResource Brush.PlayerBg}"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Image controls:AsyncImage.Url="{Binding Cover}" Stretch="UniformToFill" />
                                        <Border Background="#66000000" />
                                        <Button Tag="{Binding Url}" Click="InlineVideo_Click" Cursor="Hand"
                                                Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border CornerRadius="29" Background="#40FFFFFF" BorderBrush="#80FFFFFF"
                                                            BorderThickness="1">
                                                        <Path Data="M0 0 L17 10 L0 20 Z" Fill="White" Width="17" Height="20"
                                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Border Background="#66000000" CornerRadius="9" Padding="8,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10.5" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <!-- 视频 -->
                <Border Margin="0,16,0,0" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource Brush.PlayerBg}"
                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                    <Grid x:Name="VideoHost" Height="440" Background="Transparent"
                          MouseEnter="VideoHost_MouseEnter" MouseLeave="VideoHost_MouseLeave"
                          MouseLeftButtonUp="VideoSurface_Click">
                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True" Stretch="Uniform" Volume="0.6" />

                        <Grid x:Name="VideoCover" Background="{DynamicResource Brush.PlayerBg}">
                            <Image controls:AsyncImage.Url="{Binding Cover}" controls:AsyncImage.Fallback="Assets/Demo/cover01.jpg"
                                   Stretch="UniformToFill" />
                            <Border Background="#60000000" />

                            <Button x:Name="VideoPlayButton" Width="64" Height="64" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Click="VideoPlay_Click" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd" CornerRadius="32" Background="#40FFFFFF"
                                                BorderBrush="#80FFFFFF" BorderThickness="1">
                                            <Path Data="M0 0 L19 11 L0 22 Z" Fill="White" Width="19" Height="22"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,104,0,0">
                                <Border Background="#66000000" CornerRadius="12" Padding="12,5"
                                        Visibility="{Binding BufferText, Converter={StaticResource NotEmptyToVis}}">
                                    <TextBlock Text="{Binding BufferText}" Foreground="#E6FFFFFF" FontSize="11.5" />
                                </Border>
                                <Button Content="点击重试" Style="{StaticResource LinkButton}" Margin="0,8,0,0"
                                        Foreground="White" Command="{Binding RetryVideoCommand}"
                                        Visibility="{Binding VideoLocalPath, Converter={StaticResource InverseBoolToVis}}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="VideoPauseButton" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="64" Height="64" Cursor="Hand" Click="VideoPause_Click"
                                Visibility="Collapsed" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" CornerRadius="32" Background="#33000000">
                                        <Path Data="M0 0 H5 V18 H0 Z M9 0 H14 V18 H9 Z" Fill="#CCFFFFFF"
                                              Width="14" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 帖子视频进度条 / 下载 -->
                        <Border x:Name="VideoControls" VerticalAlignment="Bottom" Height="46"
                                Background="#99000000" Visibility="Collapsed">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="VideoToggleButton" Width="30" Height="30" Padding="0" Cursor="Hand"
                                        Click="VideoToggle_Click" ToolTip="播放 / 暂停">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="ToggleBd" CornerRadius="15" Background="#33FFFFFF">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBd" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Width="15" Height="16">
                                        <Path x:Name="TogglePlayIcon" Data="M1 1 L13 8 L1 15 Z" Fill="#FFFFFF"
                                              Stretch="Fill" />
                                        <Path x:Name="TogglePauseIcon" Data="M1 1 H5 V15 H1 Z M10 1 H14 V15 H10 Z"
                                              Fill="#FFFFFF" Stretch="Fill" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Slider x:Name="VideoProgress" Grid.Column="1" Minimum="0" Maximum="1"
                                        Height="18" VerticalAlignment="Center" Margin="6,0" Background="Transparent"
                                        Cursor="Hand" Focusable="False" IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="VideoProgress_DragStart"
                                        PreviewMouseLeftButtonUp="VideoProgress_DragEnd"
                                        ValueChanged="VideoProgress_ValueChanged">
                                    <Slider.Template>
                                        <ControlTemplate TargetType="{x:Type Slider}">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent"
                                                                      BorderThickness="0" Focusable="False" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent"
                                                                      BorderThickness="0" Focusable="False" />
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="12" Height="16" Cursor="Hand">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Grid Background="Transparent">
                                                                        <Ellipse Width="10" Height="10" Fill="#FFFFFF"
                                                                                 Stroke="#4EA4DD" StrokeThickness="1" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Slider.Template>
                                </Slider>
                                <TextBlock x:Name="VideoTime" Grid.Column="2" Text="00:00 / 00:00"
                                           Foreground="#D9FFFFFF" FontSize="10.5" VerticalAlignment="Center"
                                           Margin="8,0" />
                                <Button Grid.Column="3" Style="{StaticResource LinkButton}" Width="30" Padding="0"
                                        Click="VideoDownload_Click" ToolTip="下载视频">
                                    <Path Data="M1 10 V14 H15 V10 M8 1 V10 M5 7 L8 10 L11 7"
                                          Stroke="White" StrokeThickness="1.3" Width="16" Height="15" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 图片已按正文顺序混排在上方 blocks 中 -->

                <!-- 操作栏 -->
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="18,12" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SoftButton}" Command="{Binding LikeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♡" FontSize="15" Margin="0,-1,6,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="{Binding LikeText}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Margin="8,0,0,0" Command="{Binding FavoriteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☆" FontSize="15" Margin="0,-1,6,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="{Binding FavoriteText}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Padding="12,6"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="评论" FontSize="12" Margin="0,0,5,0"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                    <TextBlock Text="{Binding ReplyText}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Toast}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource Brush.Accent}" />
                    </Grid>
                </Border>

                <!-- 评论 -->
                <StackPanel x:Name="CommentSection" Orientation="Horizontal" Margin="2,26,0,10">
                    <TextBlock Text="{Binding [Post.Comments], Source={x:Static loc:Loc.Instance}}"
                               FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReplyText}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="8,2,0,0"
                               VerticalAlignment="Center" />
                    <Button Content="{Binding [Common.Refresh], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ReloadCommentsCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding [Post.NoComments], Source={x:Static loc:Loc.Instance}}"
                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,0,0,10"
                           Visibility="{Binding HasComments, Converter={StaticResource InverseBoolToVis}}" />

                <!-- 评论输入：更矮更圆润的单行/多行输入框 -->
                <Border x:Name="CommentComposer" Background="{DynamicResource Brush.Surface}" CornerRadius="18" Padding="10,9" Margin="0,4,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12,4">
                                <TextBox Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="58" MinHeight="52" MaxHeight="96" Padding="0"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto"
                                         FontSize="13" Background="Transparent" BorderThickness="0" />
                            </Border>
                            <Button Grid.Column="1" Content="发送" Style="{StaticResource AccentButton}" Height="34"
                                    Width="64" Margin="9,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding SendCommentCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding CommentStatus}" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="6,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding CommentStatus, Converter={StaticResource NotEmptyToVis}}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                                    Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                                                Background="{DynamicResource Brush.Card}" VerticalAlignment="Top">
                                            <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Author}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#4EA4DD" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="3"
                                                        Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Level, StringFormat=Lv.{0}}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                                <Border Background="#FFF2D6" CornerRadius="3" Padding="4,0" Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="作者" FontSize="10" Foreground="#B8860B" />
                                                </Border>
                                                <TextBlock Text="{Binding IpRegion}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Content}" FontSize="13" LineHeight="21"
                                                       TextWrapping="Wrap" Margin="0,7,0,0" />

                                            <ItemsControl ItemsSource="{Binding Images}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="112" Height="112" CornerRadius="8" ClipToBounds="True"
                                                                Background="{DynamicResource Brush.Card}" Margin="0,0,8,8"
                                                                Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="InlineImage_Click">
                                                            <Image controls:AsyncImage.Url="{Binding}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="41,8,0,0">
                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" />
                                        <Button Command="{Binding DataContext.LikeCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource LinkButton}"
                                                Margin="14,0,0,0" Height="18" Padding="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="♡" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="♡" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                                    <Setter Property="Text" Value="♥" />
                                                                    <Setter Property="Foreground" Value="#4EA4DD" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LikeText}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.DislikeCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource LinkButton}"
                                                Margin="12,0,0,0" Height="18" Padding="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="♧" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="♧" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#6A8EAE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DislikeText}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="回复" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                                FontSize="10.5" Padding="0" Height="18"
                                                Command="{Binding DataContext.ReplyToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <!-- 楼内回复：点“回复”后直接在该评论下面输入 -->
                                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="14" Padding="10,8"
                                            Margin="41,8,0,0"
                                            Visibility="{Binding IsReplyInputOpen, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10,3">
                                                <TextBox Text="{Binding ReplyInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="46" MinHeight="42" MaxHeight="80" Padding="0"
                                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                         FontSize="12.5" Background="Transparent" BorderThickness="0"
                                                         IsVisibleChanged="InlineReplyBox_IsVisibleChanged" />
                                            </Border>
                                            <Grid Margin="0,7,0,0">
                                                <TextBlock Text="{Binding InlineStatus}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="2,0,74,0" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="取消" Style="{StaticResource LinkButton}" FontSize="11"
                                                            Height="28" Padding="8,0" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="回复" Style="{StaticResource AccentButton}" Height="28"
                                                            Padding="14,0" FontSize="11"
                                                            Command="{Binding DataContext.SendInlineReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Children}" Margin="41,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                                                        Padding="10,0,0,0" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="22" Height="22" CornerRadius="11" ClipToBounds="True"
                                                                    Background="{DynamicResource Brush.Card}">
                                                                <Image controls:AsyncImage.Url="{Binding Avatar}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Author}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#4EA4DD" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Margin="29,5,0,0"
                                                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                                                   Text="{Binding ReplyToName, Mode=OneWay, StringFormat='回复 @{0}：'}"
                                                                   Visibility="{Binding HasReplyTo, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Content}" FontSize="12" LineHeight="19"
                                                                   TextWrapping="Wrap" Margin="29,2,0,0" />

                                                        <ItemsControl ItemsSource="{Binding Images}" Margin="29,6,0,0"
                                                                      Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="92" Height="92" CornerRadius="7" ClipToBounds="True"
                                                                            Background="{DynamicResource Brush.Card}" Margin="0,0,7,7"
                                                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="InlineImage_Click">
                                                                        <Image controls:AsyncImage.Url="{Binding}" Stretch="UniformToFill" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel Orientation="Horizontal" Margin="29,6,0,0">
                                                            <Button Command="{Binding DataContext.LikeCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource LinkButton}"
                                                                    Height="18" Padding="0" FontSize="10.5" Content="赞" />
                                                            <Button Content="回复" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                                    FontSize="10.5" Padding="0" Height="18"
                                                                    Command="{Binding DataContext.ReplyToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>

                                                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="8,6"
                                                                Margin="29,6,0,0"
                                                                Visibility="{Binding IsReplyInputOpen, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <Border CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,2">
                                                                    <TextBox Text="{Binding ReplyInput, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="42" MinHeight="38" Padding="0"
                                                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                                             FontSize="12" Background="Transparent" BorderThickness="0"
                                                                             IsVisibleChanged="InlineReplyBox_IsVisibleChanged" />
                                                                </Border>
                                                                <Grid Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding InlineStatus}" FontSize="10"
                                                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               Margin="2,0,70,0" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Content="取消" Style="{StaticResource LinkButton}" FontSize="10.5"
                                                                                Height="25" Padding="6,0" Margin="0,0,7,0"
                                                                                Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                        <Button Content="回复" Style="{StaticResource AccentButton}" Height="25"
                                                                                Padding="12,0" FontSize="10.5"
                                                                                Command="{Binding DataContext.SendInlineReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="2,10,0,0"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 右下角悬浮：回到顶部 / 直达评论区 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,22">
            <Button Width="44" Height="44" Cursor="Hand" Click="FloatingRefresh_Click" ToolTip="刷新帖子与评论">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M8 1.5 A6.5 6.5 0 1 0 14.6 6.5 M14.6 6.5 V2.6 M14.6 6.5 H10.7"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="44" Height="44" Margin="0,10,0,0" Cursor="Hand" Click="BackToTop_Click" ToolTip="回到帖子顶部">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M12 3 L12 21 M5 10 L12 3 L19 10" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="2.2" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="44" Height="44" Margin="0,10,0,0" Cursor="Hand" Click="GoComments_Click" ToolTip="直达评论区">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#F2FFFFFF"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path Data="M3 4 H21 V16 H11 L5 21 V16 H3 Z" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 图片灯箱：鼠标滚轮缩放，放大后可拖动查看 -->
        <Grid x:Name="ImageLightbox" Grid.Row="1" Background="#DD000000" Visibility="Collapsed">
            <ScrollViewer x:Name="LightboxScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Padding="56" Cursor="Hand"
                          PreviewMouseWheel="Lightbox_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="Lightbox_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Lightbox_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Lightbox_PreviewMouseLeftButtonUp">
                <Image x:Name="LightboxImage" Stretch="Uniform" MaxWidth="1600" MaxHeight="1200"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LightboxScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="LightboxTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer>
            <Button x:Name="LightboxPrevButton" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="18,0,0,0" Cursor="Hand" Click="LightboxPrev_Click" ToolTip="上一张图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#33FFFFFF">
                            <Path Data="M7 0 L0 7 L7 14" Stroke="White" StrokeThickness="1.8" Width="8" Height="15"
                                  Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="LightboxNextButton" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,18,0" Cursor="Hand" Click="LightboxNext_Click" ToolTip="下一张图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="22" Background="#33FFFFFF">
                            <Path Data="M0 0 L7 7 L0 14" Stroke="White" StrokeThickness="1.8" Width="8" Height="15"
                                  Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="LightboxCounter" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,22" Foreground="#B3FFFFFF" FontSize="12" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,12"
                    Width="34" Height="34" Padding="0" Cursor="Hand" Click="LightboxDownload_Click"
                    Background="#33FFFFFF" BorderThickness="0" ToolTip="下载图片">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="17">
                            <Path Data="M1 10 V14 H15 V10 M8 1 V10 M5 7 L8 10 L11 7" Stroke="White"
                                  StrokeThickness="1.4" Width="15" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="LightboxStatus" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,26,0,0" Foreground="#CCFFFFFF" FontSize="11.5" />
            <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                    Cursor="Hand" Click="CloseImageLightbox_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="20" Background="#33FFFFFF">
                            <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="White" StrokeThickness="1.6"
                                  Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 帖内视频播放器：可拖动进度条 -->
        <Grid x:Name="VideoOverlay" Grid.Row="1" Background="#EE0B1220" Visibility="Collapsed">
            <Grid Width="900" Height="560" MaxWidth="1100" MaxHeight="720">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>
                <MediaElement x:Name="InlineMedia" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="True" Stretch="Uniform" Volume="0.7"
                              MouseLeftButtonUp="InlineMedia_Click" MediaEnded="InlineMedia_MediaEnded" />
                <Border Grid.Row="1" Background="#1AFFFFFF" CornerRadius="0,0,10,10" Margin="0,0,0,0">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InlineToggleButton" Grid.Column="0" Content="❚❚" Style="{StaticResource LinkButton}"
                                Foreground="White" FontSize="13" Padding="6,0" Focusable="False"
                                Click="InlineToggle_Click" ToolTip="暂停 / 播放" />
                        <Slider x:Name="InlineProgress" Grid.Column="1" VerticalAlignment="Center" Margin="6,0"
                                Minimum="0" Maximum="100" ValueChanged="InlineProgress_ValueChanged"
                                PreviewMouseLeftButtonDown="InlineProgress_DragStart"
                                PreviewMouseLeftButtonUp="InlineProgress_DragEnd" />
                        <TextBlock x:Name="InlineTime" Grid.Column="2" Foreground="White" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                        Cursor="Hand" Click="CloseInlineVideo_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border CornerRadius="20" Background="#33FFFFFF">
                                <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="White" StrokeThickness="1.6"
                                      Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
