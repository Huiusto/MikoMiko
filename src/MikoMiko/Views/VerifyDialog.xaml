<Window x:Class="MikoMiko.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="极验安全验证" Width="470" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F6FAFE" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1ECF5" BorderThickness="0,0,0,1"
                Padding="20,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="24" CornerRadius="2" Background="#D18A2E"
                            VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="极验安全验证" FontSize="18" FontWeight="Bold"
                               Foreground="#1F2C3A" VerticalAlignment="Center" />
                    <Border Background="#FFF4E2" BorderBrush="#F0D9B4" BorderThickness="1"
                            CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="验证码 1034" FontSize="10" Foreground="#9A6B2A" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtAccount" Text="每日任务触发了米游社风险验证，验证码已直接在软件内载入"
                           FontSize="11.5" Foreground="#68788A" Margin="13,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Border Background="#FFFFFF" BorderBrush="#DCE8F2" BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#F8FBFE" />
                    <Border x:Name="LoadingPanel" Background="#F8FBFE">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                            <TextBlock x:Name="TxtLoading" Text="正在向米游社申请极验验证…" FontSize="13"
                                       Foreground="#5B6E82" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="无需打开网页，滑块会直接显示在这里" FontSize="10.5"
                                       Foreground="#96A5B4" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1ECF5" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="完成滑块后会自动提交并继续当前任务"
                           FontSize="10.5" Foreground="#8291A0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="取消" Width="92" Height="36"
                        Background="#FFFFFF" BorderBrush="#D6E3EE" BorderThickness="1"
                        Foreground="#4A5A6B" Cursor="Hand" Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
