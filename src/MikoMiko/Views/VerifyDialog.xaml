<Window x:Class="MikoMiko.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="极验安全验证" Width="540" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False"
        Background="#FFFFFF" FontFamily="Microsoft YaHei UI">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F7FAFD" BorderBrush="#E4EDF6" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="3" Height="16" CornerRadius="2" Background="#4EA4DD" />
                    <TextBlock Text="米游社安全验证" FontSize="13.5" FontWeight="SemiBold" Foreground="#26384D"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="40" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Background="Transparent" BorderThickness="0" FontSize="13"
                        Foreground="#8A9AAC" Cursor="Hand" Click="Close_Click" ToolTip="取消验证" />
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="Web" Grid.Row="1" DefaultBackgroundColor="#FFFFFF" />
        <Border x:Name="LoadingPanel" Grid.Row="1" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="TxtLoading" Text="正在向米游社申请极验验证…" FontSize="13"
                           Foreground="#5B6E82" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <!-- 账号说明仅参与初始化日志，不再占用弹窗界面 -->
                <TextBlock x:Name="TxtAccount" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Border x:Name="StatusPill" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="14,7" CornerRadius="14" Panel.ZIndex="2"
                Background="#F24EA4DD" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TxtStatus" Text="验证成功，正在完成验证…" FontSize="12" Foreground="#FFFFFF" />
        </Border>
    </Grid>
</Window>
