<Window x:Class="MikoMiko.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="米游社安全验证" Width="880" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F6FAFE" FontFamily="Microsoft YaHei UI">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1ECF5" BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="24" CornerRadius="2" Background="#D18A2E"
                                VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="米游社安全验证" FontSize="18" FontWeight="Bold"
                                   Foreground="#1F2C3A" VerticalAlignment="Center" />
                        <Border Background="#FFF4E2" BorderBrush="#F0D9B4" BorderThickness="1"
                                CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="验证码 1034" FontSize="10" Foreground="#9A6B2A" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtAccount" Text="每日任务触发了米游社风险验证，请在下方完成验证"
                               FontSize="11.5" Foreground="#68788A" Margin="13,5,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="验证完成后会自动重试当前任务"
                           FontSize="10.5" Foreground="#8A99A8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Border Background="#FFFFFF" BorderBrush="#DCE8F2" BorderThickness="1" CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Web" />
                    <Border x:Name="LoadingPanel" Background="#F8FBFE">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="正在打开米游社验证页面…" FontSize="13" Foreground="#5B6E82"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="若页面空白，请检查网络或 WebView2 运行库"
                                       FontSize="10.5" Foreground="#96A5B4" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1ECF5" BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="提示：完成滑块或短信验证后点右侧按钮；若仍提示 1034，可重新打开本窗口再试。"
                           FontSize="10.5" Foreground="#8291A0" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Width="92" Height="36" Margin="0,0,10,0"
                            Background="#FFFFFF" BorderBrush="#D6E3EE" BorderThickness="1"
                            Foreground="#4A5A6B" Cursor="Hand" Click="Cancel_Click" />
                    <Button Content="验证完成，继续任务" Width="164" Height="36"
                            Background="#2E86D6" BorderBrush="#2E86D6" BorderThickness="1"
                            Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand"
                            Click="Done_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
