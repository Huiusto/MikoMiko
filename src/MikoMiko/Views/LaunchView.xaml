<UserControl x:Class="MikoMiko.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MikoMiko.Localization"
             FontFamily="Microsoft YaHei UI"
             ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="LaunchGhost" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#D9141B24" />
            <Setter Property="BorderBrush" Value="#73FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F21B2634" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#B3FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Padding="34,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6FB8E7" Offset="0" />
                                    <GradientStop Color="#4EA4DD" Offset="0.48" />
                                    <GradientStop Color="#3D8CC4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4EA4DD" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0B0D12">
        <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="1" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0" />
                    <GradientStop Color="#3D000000" Offset="0.22" />
                    <GradientStop Color="#0A000000" Offset="0.48" />
                    <GradientStop Color="#59000000" Offset="0.78" />
                    <GradientStop Color="#D9000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#A6000000" Offset="0" />
                    <GradientStop Color="#1F000000" Offset="0.35" />
                    <GradientStop Color="#00000000" Offset="0.65" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 顶栏 -->
        <Grid VerticalAlignment="Top" Height="76" Margin="28,0,28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#334EA4DD"
                        BorderBrush="#66FFFFFF" BorderThickness="1">
                    <TextBlock Text="M" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MIKOMIKO · 启动" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="HOYO GAME LAUNCHER" Foreground="#99FFFFFF" FontSize="9.5" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh" Style="{StaticResource LaunchGhost}" Content="刷新游戏" Click="BtnRefresh_Click" />
                <Button x:Name="BtnOpenDir" Style="{StaticResource LaunchGhost}" Content="打开目录" Margin="10,0,0,0" Click="BtnOpenDir_Click" />
            </StackPanel>
        </Grid>

        <!-- 游戏切换 -->
        <StackPanel x:Name="GameRail" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" />

        <!-- 底部信息 -->
        <Grid VerticalAlignment="Bottom" Margin="32,0,34,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom" MaxWidth="700">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtGameName" Text="原神" Foreground="#FFFFFF" FontSize="40" FontWeight="Bold" />
                    <Border x:Name="InstalledBadge" Background="#2E8B57" CornerRadius="9" Padding="9,3" Margin="14,0,0,8"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBadge" Text="已安装" Foreground="#FFFFFF" FontSize="10.5" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="提瓦特大陆，等待你的到来" Foreground="#D9FFFFFF"
                           FontSize="14" Margin="0,4,0,0" />
                <TextBlock x:Name="TxtPath" Text="" Foreground="#8CFFFFFF" FontSize="11.5" Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button x:Name="BtnLaunch" Style="{StaticResource LaunchPrimary}" Content="开始游戏" Click="BtnLaunch_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="BtnLocate" Style="{StaticResource LaunchGhost}" Content="定位游戏" Click="BtnLocate_Click" />
                    <Button x:Name="BtnOfficial" Style="{StaticResource LaunchGhost}" Content="官方网站" Margin="10,0,0,0" Click="BtnOfficial_Click" />
                </StackPanel>
                <TextBlock x:Name="TxtHint" Text="选择左侧游戏图标切换启动页" Foreground="#B3FFFFFF" FontSize="11"
                           HorizontalAlignment="Right" Margin="0,12,0,0" TextAlignment="Right" MaxWidth="440"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border x:Name="ToastBox" Background="#E6171B22" CornerRadius="10" Padding="16,9"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="TxtToast" Foreground="#FFFFFF" FontSize="12.5" />
        </Border>
    </Grid>
</UserControl>
