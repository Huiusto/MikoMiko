<UserControl x:Class="MikoMiko.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" ClipToBounds="True">
    <Grid x:Name="Root" ClipToBounds="True">
        <!-- 背景：随游戏切换 -->
        <Image x:Name="ImgBackground" Stretch="UniformToFill" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F20B1A28" Offset="0" />
                    <GradientStop Color="#B80D1E2D" Offset="0.36" />
                    <GradientStop Color="#4D102333" Offset="0.65" />
                    <GradientStop Color="#1A102333" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#D9081520" Offset="0" />
                    <GradientStop Color="#00101C28" Offset="0.55" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 品牌区 -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50,28,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦" FontSize="26" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="TxtLogo" Text="原神" FontSize="34" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 游戏切换：不打断参考图的左侧主视觉，收在右上角 -->
        <StackPanel x:Name="GameStrip" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,24,42,0" />

        <!-- 左侧主文案 -->
        <StackPanel x:Name="HeroPanel" VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="56,92,0,0" MaxWidth="610">
            <TextBlock x:Name="TxtHeroVersion" Text="VERSION 7.2" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#D8ECFA" Opacity="0.88" />
            <TextBlock x:Name="TxtHeroTitle" Text="晶石如林生长之地" FontSize="43" FontWeight="Bold"
                       Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="56">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#001018" BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="TxtHeroSubtitle" Text="新地区「新基捷城」、「如翼之峰」现已开放"
                       FontSize="18" Foreground="#F5DE9B" TextWrapping="Wrap" Margin="0,13,0,0" LineHeight="27" />
            <Button x:Name="BtnHotspot" Width="128" Height="44" HorizontalAlignment="Left" Margin="0,22,0,0"
                    Background="#1AFFFFFF" Foreground="#FFFFFF" BorderBrush="#D9FFFFFF" BorderThickness="1"
                    Cursor="Hand" Click="BtnHotspot_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter />
                                <TextBlock Text="›" FontSize="15" Margin="7,0,0,0" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="版本热点" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
            </Button>
        </StackPanel>

        <!-- 左下活动卡 -->
        <Border x:Name="ActivityCard" Width="560" Height="380" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="52,0,0,30" CornerRadius="14" Background="#F21A2736" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#04111B" BlurRadius="24" ShadowDepth="6" Opacity="0.38" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="270" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image x:Name="ImgActivity" Grid.Row="0" Stretch="UniformToFill" />

                <Grid Grid.Row="1" Margin="16,0,16,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabActivity" Content="活动" Background="Transparent" BorderThickness="0"
                                    Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                    Padding="2,0,20,0" Click="TabActivity_Click" />
                            <Button x:Name="TabNotice" Content="公告" Background="Transparent" BorderThickness="0"
                                    Foreground="#9FB3C4" FontSize="12" Cursor="Hand" Padding="0,0,20,0"
                                    Click="TabNotice_Click" />
                            <Button x:Name="TabNews" Content="资讯" Background="Transparent" BorderThickness="0"
                                    Foreground="#9FB3C4" FontSize="12" Cursor="Hand" Padding="0,0,20,0"
                                    Click="TabNews_Click" />
                        </StackPanel>
                        <Border x:Name="TabIndicator" Width="22" Height="2" Background="#FFD84D" CornerRadius="1"
                                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Grid>
                    <Border Grid.Row="1" Background="#663A4B5C" />

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtActivity1" Text="「新基捷城」区域探索开启" FontSize="11.5"
                                       Foreground="#E8F1F7" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtActivityDate1" Grid.Column="1" Text="11/26" FontSize="10.5"
                                       Foreground="#A8BAC8" Margin="10,0,0,0" />
                        </Grid>
                        <Border Height="1" Background="#333A4B5C" Margin="0,7,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtActivity2" Text="「如翼之峰」版本主题活动" FontSize="11.5"
                                       Foreground="#E8F1F7" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtActivityDate2" Grid.Column="1" Text="11/22" FontSize="10.5"
                                       Foreground="#A8BAC8" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 右下主按钮 -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,44,104">
            <Button x:Name="BtnPrimary" Width="316" Height="72" Cursor="Hand" Click="BtnPrimary_Click"
                    Background="#FFD84D" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="36">
                            <Border.Effect>
                                <DropShadowEffect Color="#00121D" BlurRadius="22" ShadowDepth="5" Opacity="0.32" />
                            </Border.Effect>
                            <Grid Margin="25,0,18,0">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="20" FontWeight="Bold"
                                           Foreground="#18222B" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Border Width="42" Height="42" CornerRadius="21" Background="#1C2934"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding CommandParameter}" FontSize="19" FontWeight="Bold"
                                               Foreground="#FFD84D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FFE164" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnLocate" Content="已安装？定位游戏" Height="28" Margin="0,12,7,0"
                    HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="#E8F4FE" FontSize="11.5" Opacity="0.86" Click="BtnLocate_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="TxtFooter" Text="MIKOMIKO · 本地游戏启动器" FontSize="9.5" Foreground="#B8D2E4"
                       HorizontalAlignment="Right" Margin="0,9,8,0" Opacity="0.68" />
        </StackPanel>

        <!-- 状态提示 -->
        <Border x:Name="TxtToast" Background="#E6112230" CornerRadius="8" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Visibility="Collapsed">
            <TextBlock x:Name="TxtToastText" Text="" FontSize="12" Foreground="#EAF6FF" />
        </Border>
    </Grid>
</UserControl>
