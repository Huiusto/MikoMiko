<UserControl x:Class="MikoMiko.Views.AnimeSitePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Background="#0B131C">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111B26" BorderBrush="#1F2C3A" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Width="30" Height="30" Click="Back_Click"
                        ToolTip="返回追番页" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Path Data="M9 0 L1 8 L9 16" Stroke="#D7E6F2" StrokeThickness="1.5"
                          Width="9" Height="16" Stretch="Uniform" />
                </Button>

                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="#F2F7FB"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" FontSize="10" Foreground="#8093A6" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2" Height="27" Padding="12,0" Margin="0,0,8,0" Click="Reload_Click"
                        Content="重新加载" Foreground="#B9CADA" Background="#1A2634"
                        BorderBrush="#2A3B4C" BorderThickness="1" Cursor="Hand" FontSize="10.5" />

                <Button Grid.Column="3" Height="27" Padding="12,0" Click="Browser_Click"
                        Content="浏览器打开" Foreground="#B9CADA" Background="#1A2634"
                        BorderBrush="#2A3B4C" BorderThickness="1" Cursor="Hand" FontSize="10.5" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" Visibility="Hidden" />

        <Border x:Name="StatusPanel" Grid.Row="1" Background="#0B131C">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock x:Name="StatusTitle" Text="正在打开站点播放页…" Foreground="#DCEAF5"
                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Text="站点播放页会加载自己的播放器，可能需要几秒。"
                           Foreground="#7F96AA" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
