<Window x:Class="MikoMiko.Views.InstallGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装游戏"
        Width="720" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#556477"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="#FFFFFF"
                                BorderBrush="#DCE5EF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F6FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="#4EA4DD"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D93CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangRb" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#556477"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F7FAFD" BorderBrush="#DDE7F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.20" Color="#172435"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EEF5FB" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <TextBlock x:Name="TxtTitle" Text="安装游戏" FontSize="16" FontWeight="SemiBold"
                               Foreground="#233648" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="42" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" FontSize="15"
                            Foreground="#7A8B9C" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#DDEAF5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,18,26,0">
                <TextBlock x:Name="TxtGameInfo" Text="原神" FontSize="14" FontWeight="SemiBold"
                           Foreground="#233648"/>
                <TextBlock Text="像官方启动器一样按文件清单直接写入游戏目录。点「开始安装」后本窗口会关闭，进度显示在启动页的按钮上。"
                           FontSize="11.5" Foreground="#7A8B9C" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="安装路径" FontSize="12.5" Foreground="#7A8B9C" Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="7"
                            Height="38">
                        <TextBlock x:Name="TxtPath" FontSize="12" Foreground="#556477"
                                   VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnBrowse" Content="更改" Style="{StaticResource GhostBtn}"
                            Height="38" Margin="10,0,0,0" Padding="22,0" MinWidth="78" Click="BtnBrowse_Click"/>
                </Grid>
                <CheckBox x:Name="ChkSubFolder" Content="自动创建游戏子文件夹" IsChecked="True"
                          FontSize="12" Foreground="#556477" Margin="0,10,0,0"
                          Checked="ChkSubFolder_Changed" Unchecked="ChkSubFolder_Changed"/>

                <TextBlock Text="游戏语言" FontSize="12.5" Foreground="#7A8B9C" Margin="0,14,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RdoZh" Style="{StaticResource LangRb}" Content="汉语" GroupName="lang" IsChecked="True"/>
                    <RadioButton x:Name="RdoEn" Style="{StaticResource LangRb}" Content="英语" GroupName="lang"/>
                    <RadioButton x:Name="RdoJa" Style="{StaticResource LangRb}" Content="日语" GroupName="lang"/>
                    <RadioButton x:Name="RdoKo" Style="{StaticResource LangRb}" Content="韩语" GroupName="lang"/>
                </StackPanel>

                <Border Background="#FFFFFF" BorderBrush="#E3EBF3" BorderThickness="1" CornerRadius="8"
                        Margin="0,16,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtSpace" Text="正在获取官方安装信息…" FontSize="11.5"
                                   Foreground="#556477" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="26,0,26,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostBtn}" MinWidth="96" Click="BtnClose_Click"/>
                    <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource PrimaryBtn}"
                            MinWidth="130" Margin="12,0,0,0" Click="BtnInstall_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
