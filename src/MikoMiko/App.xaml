<Application x:Class="MikoMiko.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoMiko.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全站统一加载动画：MikoMiko 手写 Logo + 进度线 GIF -->
            <Style x:Key="LoadingGif" TargetType="{x:Type controls:AnimatedGif}">
                <Setter Property="GifPath" Value="/Assets/Setup/loading.gif" />
                <Setter Property="Width" Value="210" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
