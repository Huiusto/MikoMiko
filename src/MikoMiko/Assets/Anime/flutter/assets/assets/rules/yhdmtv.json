{
  "api": "4",
  "type": "anime",
  "name": "yhdmtv",
  "displayName": "樱花TV",
  "version": "1.4",
  "description": "樱花TV（yhdmtv.cc）规则，搜索使用站内公开的搜索片段页，详情与选集按 MacCMS 结构采集。",
  "baseURL": "https://www.yhdmtv.cc/",
  "searchURL": "https://www.yhdmtv.cc/public/auto/search1.html?keyword=@keyword",
  "searchList": "//div[@class='module-card-item module-item']",
  "searchName": ".//div[contains(@class,'module-card-item-title')]",
  "searchResult": ".//a[contains(@class,'module-card-item-poster')]/@href",
  "chapterRoads": "//div[contains(@class,'module-play-list-content')]",
  "chapterResult": ".//a[contains(@class,'module-play-list-link')]",
  "searchPoster": ".//img/@data-original",
  "searchNote": ".//div[contains(@class,'module-item-note')]",
  "detailPoster": "//meta[@property='og:image']/@content",
  "detailDescription": "//meta[@name='description']/@content",
  "homeURL": "https://www.yhdmtv.cc/",
  "homeList": "//a[contains(@class,'module-poster-item')]",
  "homeName": ".//div[contains(@class,'module-poster-item-title')]",
  "homeResult": "./@href",
  "homePoster": ".//img/@data-original",
  "homeNote": ".//div[contains(@class,'module-item-note')]",
  "builtIn": true
}
