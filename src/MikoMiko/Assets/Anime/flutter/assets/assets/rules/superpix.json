{
  "api": "4",
  "type": "anime",
  "name": "superpix",
  "displayName": "PIDEC",
  "version": "1.4",
  "description": "PIDEC（superpix.com.cn）苹果 CMS 规则，采集首页、搜索、详情与多线路选集。",
  "baseURL": "https://superpix.com.cn/",
  "searchURL": "https://superpix.com.cn/search.php?searchword=@keyword",
  "searchList": "//div[contains(@class,'stui-vodlist__box')]",
  "searchName": ".//h4[contains(@class,'title')]",
  "searchResult": ".//a[contains(@class,'stui-vodlist__thumb')]/@href",
  "chapterRoads": "//ul[contains(@class,'stui-content__playlist')]",
  "chapterResult": ".//a[contains(@href,'/play/')]",
  "searchPoster": ".//a[contains(@class,'stui-vodlist__thumb')]/@data-original",
  "searchNote": ".//span[contains(@class,'pic-text')]",
  "detailPoster": "//meta[@property='og:image']/@content",
  "detailDescription": "//meta[@name='description']/@content",
  "homeURL": "https://superpix.com.cn/",
  "homeList": "//div[contains(@class,'stui-vodlist__box')]",
  "homeName": ".//h4[contains(@class,'title')]",
  "homeResult": ".//a[contains(@class,'stui-vodlist__thumb')]/@href",
  "homePoster": ".//a[contains(@class,'stui-vodlist__thumb')]/@data-original",
  "homeNote": ".//span[contains(@class,'pic-text')]",
  "builtIn": true
}
